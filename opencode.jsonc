{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "edit", "resource": "/*", "effect": "deny" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git -C * commit *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl patch *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl * patch *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl delete *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl * delete *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git -C * push *", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl edit *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl * edit *", "effect": "deny" },
    { "action": "shell", "resource": "talosctl patch *", "effect": "deny" },
    { "action": "shell", "resource": "talosctl * patch *", "effect": "deny" },
    { "action": "shell", "resource": "kubectl delete *backup*", "effect": "deny" },
    { "action": "shell", "resource": "kubectl * delete *backup*", "effect": "deny" },
    { "action": "shell", "resource": "rc rm *-r*", "effect": "deny" },
    { "action": "shell", "resource": "rc rm *-?r*", "effect": "deny" },
    { "action": "shell", "resource": "rustfs rm *-r*", "effect": "deny" },
    { "action": "shell", "resource": "rustfs rm *-?r*", "effect": "deny" },
    { "action": "shell", "resource": "docker exec *rc rm *-r*", "effect": "deny" },
    { "action": "shell", "resource": "docker exec *rc rm *-?r*", "effect": "deny" },
    { "action": "shell", "resource": "talosctl edit *", "effect": "deny" },
    { "action": "shell", "resource": "talosctl * edit *", "effect": "deny" }
  ],
  "agents": {
    "plan": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": ".agents/temp/*", "effect": "allow" }
      ]
    }
  }
}
