    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "max by (namespace, job_name) (kube_job_failed{condition=\"true\"})",
    "promql_condition": {
      "column": "value",
      "operator": ">=",
      "value": 1,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 1,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "destinations": [
    "email"
  ],
  "context_attributes": {},
  "row_template": "Namespace: {namespace} | Job: {job_name}",
  "row_template_type": "String",
  "description": "A Kubernetes Job has failed; the alert row names namespace and job_name. Read the pod logs (O2 k8s_logs keeps them after the Job is gone) and events. Level signal: it clears when the failed Job object is deleted. talos-backup Jobs age out 24h after finishing (ttlSecondsAfterFinished, cmdshift/platform#239, runbook etcd-backups.md); trivy scan Jobs after 10m.",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false
