{
  "name": "flux_kustomization_failure",
  "title": "Flux Kustomization Failure",
  "severity": "warning",
  "description": "Warning: Kustomization reconcile errors on kustomize-controller (increase >0 over 15m) — run flux get kustomizations -A | grep <name>, then check controller logs (reconcile-stuck / pipeline-wedged skills). Adapted from upstream gotk_resource_info: flux v2.7-era controllers no longer export it (cmdshift/platform#206).",
  "tags": [
    "awesome-prometheus-alerts",
    "embedded-exporter",
    "fluxcd"
  ],
  "docs_url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/fluxcd/",
  "source": {
    "project": "awesome-prometheus-alerts",
    "license": "CC-BY-4.0",
    "url": "https://samber.github.io/awesome-prometheus-alerts/rules/ci-cd/fluxcd/",
    "exporter": "embedded-exporter",
    "upstream_alert": "Flux Kustomization Failure",
    "upstream_query": "gotk_resource_info{ready=\"False\", customresource_kind=\"Kustomization\"} > 0",
    "upstream_description": "The {{ $labels.customresource_kind }} '{{ $labels.name }}' in namespace {{ $labels.exported_namespace }} is marked as not ready."
  },
  "stream_type": "metrics",
  "stream_name": "controller_runtime_reconcile_total",
  "is_real_time": false,
  "query_condition": {
    "type": "promql",
    "conditions": {
      "version": 2,
      "conditions": {
        "filterType": "group",
        "logicalOperator": "AND",
        "conditions": []
      }
    },
    "sql": null,
    "promql": "increase(controller_runtime_reconcile_total{controller=\"kustomization\", result=\"error\"}[15m]) > 0",
    "promql_condition": {
      "column": "value",
      "operator": ">",
      "value": 0,
      "ignore_case": false
    },
    "aggregation": null,
    "vrl_function": null,
    "search_event_type": null,
    "multi_time_range": []
  },
  "trigger_condition": {
    "period": 15,
    "operator": ">=",
    "threshold": 1,
    "frequency": 5,
    "cron": "",
    "frequency_type": "minutes",
    "silence": 60,
    "timezone": "UTC",
    "tolerance_in_secs": null,
    "align_time": true
  },
  "destinations": [
    "email"
  ],
  "context_attributes": {},
  "row_template": "*{alert_name}* | controller: {controller} | reconcile errors (15m): {value}",
  "row_template_type": "String",
  "enabled": true,
  "tz_offset": 0,
  "creates_incident": false
}
