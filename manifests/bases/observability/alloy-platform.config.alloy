// kube-state-metrics is scraped by the chart's alloy-telemetry collector
// (clusterMetrics.kube-state-metrics feature) — not duplicated here. Its
// keep-filter covers every family the rules and dashboards reference.

discovery.relabel "targets_loki" {
  targets = discovery.kubernetes.services.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_service_label_app_kubernetes_io_instance", "__meta_kubernetes_service_label_app_kubernetes_io_name"]
    action        = "keep"
    regex         = "observability;loki;loki"
  }

  rule {
    source_labels = ["__meta_kubernetes_service_port_name"]
    action        = "keep"
    regex         = "http-metrics"
  }
}

prometheus.scrape "loki" {
  job_name   = "loki"
  targets    = discovery.relabel.targets_loki.output
  forward_to = [prometheus.remote_write.mimir.receiver]
}

discovery.relabel "targets_tempo" {
  targets = discovery.kubernetes.services.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_service_label_app_kubernetes_io_instance", "__meta_kubernetes_service_label_app_kubernetes_io_name"]
    action        = "keep"
    regex         = "observability;tempo;tempo"
  }

  rule {
    source_labels = ["__meta_kubernetes_service_port_name"]
    action        = "keep"
    regex         = "tempo-prom-metrics"
  }
}

prometheus.scrape "tempo" {
  job_name   = "tempo"
  targets    = discovery.relabel.targets_tempo.output
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// ---------------------------------------------------------------------------
// Self-scrape: platform collector's own metrics via the default Service port.
// ---------------------------------------------------------------------------

discovery.relabel "targets_platform" {
  targets = discovery.kubernetes.endpoints.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_label_alloy_platform"]
    action        = "keep"
    regex         = "observability;metrics"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_ip"]
    action        = "replace"
    target_label  = "__address__"
    regex         = "(.+)"
    replacement   = "${1}:12345"
  }
}

prometheus.scrape "platform" {
  job_name   = "alloy-platform"
  targets    = discovery.relabel.targets_platform.output
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// Logging collector self-scrape: its default Service carries http-metrics.
discovery.relabel "targets_alloy_logging" {
  targets = discovery.kubernetes.endpoints.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_service_label_app_kubernetes_io_instance", "__meta_kubernetes_service_label_app_kubernetes_io_name"]
    action        = "keep"
    regex         = "observability;alloy-logging;alloy"
  }

  rule {
    source_labels = ["__meta_kubernetes_endpoint_port_name"]
    action        = "keep"
    regex         = "http-metrics"
  }
}

prometheus.scrape "alloy_logging" {
  job_name   = "alloy-logging"
  targets    = discovery.relabel.targets_alloy_logging.output
  forward_to = [prometheus.remote_write.mimir.receiver]
}
