    action        = "keep"
    regex         = "metrics"
  }
}

prometheus.scrape "hubble_relay" {
  job_name   = "hubble-relay"
  targets    = discovery.relabel.targets_hubble_relay.output
  forward_to = [prometheus.remote_write.mimir.receiver]
