// alloy-telemetry: metrics (scrape -> mimir remote_write) + traces (OTLP -> tempo).
// Logs live in the alloy-logging release. Replaces the OTel collector + target
// allocator as the sole scraper and OTLP receiver (cmdshift/platform#146).
//
// Label parity: the five control-plane jobs keep the exact job names the OTel
// collector produced (apiserver/cadvisor/kubelet/kube-controller-manager/
// kube-scheduler) — mimir-rules.yaml and the dashboards select on them. The
// ServiceMonitor-replacement families never landed in mimir (the target
// allocator's prometheusCR watcher was dead from cache-sync failure since
// 2026-09-22), so their job labels are a fresh baseline named after each
// service.

logging {
  level  = "info"
  format = "json"
}

// ---------------------------------------------------------------------------
// prometheus.remote_write -> mimir (tenant self-monitoring)
// ---------------------------------------------------------------------------

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir.observability.svc:8080/api/v1/push"

    headers = {
      "X-Scope-OrgID" = "self-monitoring",
    }
  }
}

discovery.kubernetes "nodes" {
  role = "node"
}

discovery.kubernetes "pods" {
  role = "pod"
}

discovery.kubernetes "services" {
  role = "service"
}

// endpoints role expands to one target per backing pod — service-role targets
// would scrape the ClusterIP, load-balancing across replicas and losing
// per-pod series (node-exporter/cilium-agent/alloy-logging/alertmanager)
discovery.kubernetes "endpoints" {
  role = "endpoints"
}

// ---------------------------------------------------------------------------
// Control-plane scrapes (ported 1:1 from the OTel collector config).
// TLS + SA bearer token; kubelet/cadvisor authorize via SubjectAccessReview
// on nodes/{subresource} (nodes/metrics + nodes/proxy RBAC, see
// alloy-telemetry.rbac.yaml).
// ---------------------------------------------------------------------------

prometheus.scrape "kubelet" {
  job_name          = "kubelet"
  targets           = discovery.kubernetes.nodes.targets
  scheme            = "https"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  forward_to        = [prometheus.remote_write.mimir.receiver]

  tls_config {
    insecure_skip_verify = true
  }
}

prometheus.scrape "cadvisor" {
  job_name          = "cadvisor"
  targets           = discovery.kubernetes.nodes.targets
  scheme            = "https"
  metrics_path      = "/metrics/cadvisor"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  forward_to        = [prometheus.remote_write.mimir.receiver]

  tls_config {
    insecure_skip_verify = true
  }
}

// apiserver via the default/kubernetes endpoints
discovery.kubernetes "apiserver_endpoints" {
  role = "endpoints"

  namespaces {
    names = ["default"]
  }
}

discovery.relabel "keep_apiserver" {
  targets = discovery.kubernetes.apiserver_endpoints.targets

  rule {
    source_labels = ["__meta_kubernetes_service_label_component", "__meta_kubernetes_service_label_provider"]
    action        = "keep"
    regex         = "apiserver;kubernetes"
  }
}

prometheus.scrape "apiserver" {
  job_name          = "apiserver"
  targets           = discovery.relabel.keep_apiserver.output
  scheme            = "https"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  forward_to        = [prometheus.remote_write.mimir.receiver]

  tls_config {
    ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
  }
}

// host-network static pods — SD by pod label, fixed host ports
discovery.relabel "keep_controller_manager" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_label_component"]
    action        = "keep"
    regex         = "kube-controller-manager"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_phase"]
    action        = "drop"
    regex         = "Pending|Succeeded|Failed|Completed"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_host_ip"]
    action        = "replace"
    target_label  = "__address__"
    regex         = "(.+)"
    replacement   = "${1}:10257"
  }
}

prometheus.scrape "kube_controller_manager" {
  job_name          = "kube-controller-manager"
  targets           = discovery.relabel.keep_controller_manager.output
  scheme            = "https"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  forward_to        = [prometheus.remote_write.mimir.receiver]

  tls_config {
    insecure_skip_verify = true
  }
}

discovery.relabel "keep_scheduler" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_label_component"]
    action        = "keep"
    regex         = "kube-scheduler"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_phase"]
    action        = "drop"
    regex         = "Pending|Succeeded|Failed|Completed"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_host_ip"]
    action        = "replace"
    target_label  = "__address__"
    regex         = "(.+)"
    replacement   = "${1}:10259"
  }
}

prometheus.scrape "kube_scheduler" {
  job_name          = "kube-scheduler"
  targets           = discovery.relabel.keep_scheduler.output
  scheme            = "https"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  forward_to        = [prometheus.remote_write.mimir.receiver]

  tls_config {
    insecure_skip_verify = true
  }
}

// ---------------------------------------------------------------------------
// Service metrics (replaces the ServiceMonitor/target-allocator discovery).
// One family per source ServiceMonitor: a discovery.relabel keeps the services
// matching that SM's label-selector + endpoint port name; the scrape names the
// job after the service.
// ---------------------------------------------------------------------------

// --- kube-system ---

discovery.relabel "targets_cilium_agent" {
  targets = discovery.kubernetes.endpoints.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_service_label_app_kubernetes_io_name"]
    action        = "keep"
    regex         = "kube-system;cilium-agent"
  }

  rule {
    source_labels = ["__meta_kubernetes_endpoint_port_name"]
    action        = "keep"
    regex         = "metrics"
  }
}

prometheus.scrape "cilium_agent" {
  job_name   = "cilium-agent"
  targets    = discovery.relabel.targets_cilium_agent.output
  forward_to = [prometheus.remote_write.mimir.receiver]
}

discovery.relabel "targets_cilium_operator" {
  targets = discovery.kubernetes.services.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_service_label_io_cilium_app", "__meta_kubernetes_service_label_name"]
    action        = "keep"
    regex         = "kube-system;operator;cilium-operator"
  }

  rule {
    source_labels = ["__meta_kubernetes_service_port_name"]
    action        = "keep"
    regex         = "metrics"
  }
}

prometheus.scrape "cilium_operator" {
  job_name   = "cilium-operator"
  targets    = discovery.relabel.targets_cilium_operator.output
  forward_to = [prometheus.remote_write.mimir.receiver]
}

discovery.relabel "targets_hubble_relay" {
