}

// ---------------------------------------------------------------------------
// Traces: OTLP receivers -> tempo (workloads push to alloy-telemetry:4317/4318).
// Untested until instrumented workloads exist (cmdshift/platform#146) — the
// receiver+pipeline are live so the ports answer as soon as something sends.
// ---------------------------------------------------------------------------

otelcol.receiver.otlp "workloads" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = []
    logs    = []
    traces  = [otelcol.processor.k8sattributes.traces.input]
  }
}

otelcol.processor.k8sattributes "traces" {
  output {
    traces = [otelcol.processor.memory_limiter.traces.input]
  }
}

otelcol.processor.memory_limiter "traces" {
  check_interval         = "5s"
  limit_percentage       = 80
  spike_limit_percentage = 20

  output {
    traces = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "http://tempo.observability.svc:4318"
  }
}
