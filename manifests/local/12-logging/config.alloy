logging {
  level  = "info"
  format = "logfmt"
}

discovery.kubernetes "pods" {
  role = "pod"
}

loki.source.kubernetes "pods" {
  targets    = discovery.kubernetes.pods.targets
  forward_to = [loki.process.wrap.receiver]
}

loki.process "wrap" {
  forward_to = [loki.write.endpoint.receiver]

  stage.pack {
    labels = ["namespace", "pod", "container", "node"]
  }
}

loki.write "endpoint" {
  endpoint {
    url       = "http://loki.logging.svc:3100/loki/api/v1/push"
    tenant_id = "self-monitoring"
  }
}
