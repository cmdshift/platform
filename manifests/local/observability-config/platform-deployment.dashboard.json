{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Deployment-scoped view (issue #39): per-container CPU/memory usage vs requests/limits, pods & nodes, PVC disk usage, recent logs. The Deployment variable defaults to a sentinel All that matches nothing - pick a deployment to populate the dashboard.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Pods of the selected deployment and the nodes they run on",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "pluginVersion": "13.1.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "kube_pod_info{namespace=\"$namespace\"} * on(namespace, pod) group_left() (kube_pod_owner{namespace=\"$namespace\", owner_kind=\"ReplicaSet\"} * on(namespace, owner_name) group_left() label_replace(kube_replicaset_owner{namespace=\"$namespace\", owner_kind=\"Deployment\", owner_name=~\"$deployment\"}, \"owner_name\", \"$1\", \"replicaset\", \"(.+)\"))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Pods & Nodes",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "service": true,
              "namespace": true,
              "uid": true,
              "host_ip": true,
              "host_network": true,
              "created_by_kind": true,
              "created_by_name": true,
              "priority_class": true
            },
            "indexByName": {
              "pod": 0,
              "node": 1,
              "pod_ip": 2
            },
            "renameByName": {
              "pod": "Pod",
              "node": "Node",
              "pod_ip": "Pod IP"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Used bytes / capacity of the deployment's PVCs",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "percent",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 0
      },
      "id": 11,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "13.1.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "100 * kubelet_volume_stats_used_bytes{namespace=\"$namespace\"} / kubelet_volume_stats_capacity_bytes{namespace=\"$namespace\"} * on(namespace, persistentvolumeclaim) group_left() (sum by (namespace, persistentvolumeclaim) (kube_pod_spec_volumes_persistentvolumeclaims_info{namespace=\"$namespace\"} * on(namespace, pod) group_left() (kube_pod_owner{namespace=\"$namespace\", owner_kind=\"ReplicaSet\"} * on(namespace, owner_name) group_left() label_replace(kube_replicaset_owner{namespace=\"$namespace\", owner_kind=\"Deployment\", owner_name=~\"$deployment\"}, \"owner_name\", \"$1\", \"replicaset\", \"(.+)\"))) * 0 + 1)",
          "instant": false,
          "legendFormat": "{{persistentvolumeclaim}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "PVC disk usage",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Cores",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "none",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 12,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "13.1.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container!=\"\"}[$__rate_interval]) * on(namespace, pod) group_left() (kube_pod_owner{namespace=\"$namespace\", owner_kind=\"ReplicaSet\"} * on(namespace, owner_name) group_left() label_replace(kube_replicaset_owner{namespace=\"$namespace\", owner_kind=\"Deployment\", owner_name=~\"$deployment\"}, \"owner_name\", \"$1\", \"replicaset\", \"(.+)\")))",
          "instant": false,
          "legendFormat": "{{container}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (container) (kube_pod_container_resource_requests{namespace=\"$namespace\", resource=\"cpu\"} * on(namespace, pod) group_left() (kube_pod_owner{namespace=\"$namespace\", owner_kind=\"ReplicaSet\"} * on(namespace, owner_name) group_left() label_replace(kube_replicaset_owner{namespace=\"$namespace\", owner_kind=\"Deployment\", owner_name=~\"$deployment\"}, \"owner_name\", \"$1\", \"replicaset\", \"(.+)\")))",
          "instant": false,
          "legendFormat": "{{container}} (request)",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (container) (kube_pod_container_resource_limits{namespace=\"$namespace\", resource=\"cpu\"} * on(namespace, pod) group_left() (kube_pod_owner{namespace=\"$namespace\", owner_kind=\"ReplicaSet\"} * on(namespace, owner_name) group_left() label_replace(kube_replicaset_owner{namespace=\"$namespace\", owner_kind=\"Deployment\", owner_name=~\"$deployment\"}, \"owner_name\", \"$1\", \"replicaset\", \"(.+)\")))",
          "instant": false,
          "legendFormat": "{{container}} (limit)",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "CPU: usage vs requests/limits by container",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Working set",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "bytes",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 13,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "13.1.3",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\", image!=\"\"} * on(namespace, pod) group_left() (kube_pod_owner{namespace=\"$namespace\", owner_kind=\"ReplicaSet\"} * on(namespace, owner_name) group_left() label_replace(kube_replicaset_owner{namespace=\"$namespace\", owner_kind=\"Deployment\", owner_name=~\"$deployment\"}, \"owner_name\", \"$1\", \"replicaset\", \"(.+)\")))",
          "instant": false,
          "legendFormat": "{{container}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (container) (kube_pod_container_resource_requests{namespace=\"$namespace\", resource=\"memory\"} * on(namespace, pod) group_left() (kube_pod_owner{namespace=\"$namespace\", owner_kind=\"ReplicaSet\"} * on(namespace, owner_name) group_left() label_replace(kube_replicaset_owner{namespace=\"$namespace\", owner_kind=\"Deployment\", owner_name=~\"$deployment\"}, \"owner_name\", \"$1\", \"replicaset\", \"(.+)\")))",
          "instant": false,
          "legendFormat": "{{container}} (request)",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (container) (kube_pod_container_resource_limits{namespace=\"$namespace\", resource=\"memory\"} * on(namespace, pod) group_left() (kube_pod_owner{namespace=\"$namespace\", owner_kind=\"ReplicaSet\"} * on(namespace, owner_name) group_left() label_replace(kube_replicaset_owner{namespace=\"$namespace\", owner_kind=\"Deployment\", owner_name=~\"$deployment\"}, \"owner_name\", \"$1\", \"replicaset\", \"(.+)\")))",
          "instant": false,
          "legendFormat": "{{container}} (limit)",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Memory: usage vs requests/limits by container",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "datasource",
        "uid": "grafana"
      },
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 6,
      "options": {
        "code": {
          "language": "markdown",
          "showLineNumbers": false
        },
        "content": "<div style=\"display:flex;align-items:center;gap:8px;flex-wrap:wrap;\"><span style=\"color:#8e8e8e;font-size:13px;\">Log query presets</span><a href=\"/d/platform-deployment?var-namespace=$namespace&var-deployment=$deployment&from=$__from&to=$__to&var-log_query=%7C%20detected_level%3D%22error%22\" style=\"padding:3px 12px;background:#22252b;color:#d8d9da;border:1px solid #464c54;border-radius:4px;text-decoration:none;font-size:13px;\">errors</a><a href=\"/d/platform-deployment?var-namespace=$namespace&var-deployment=$deployment&from=$__from&to=$__to&var-log_query=%7C%20detected_level%3D%22warn%22\" style=\"padding:3px 12px;background:#22252b;color:#d8d9da;border:1px solid #464c54;border-radius:4px;text-decoration:none;font-size:13px;\">warnings</a><a href=\"/d/platform-deployment?var-namespace=$namespace&var-deployment=$deployment&from=$__from&to=$__to&var-log_query=%7C%20detected_level%3D%22debug%22\" style=\"padding:3px 12px;background:#22252b;color:#d8d9da;border:1px solid #464c54;border-radius:4px;text-decoration:none;font-size:13px;\">debug</a><a href=\"/d/platform-deployment?var-namespace=$namespace&var-deployment=$deployment&from=$__from&to=$__to&var-log_query=%7C%20json%20%7C%20level%3D%22error%22\" style=\"padding:3px 12px;background:#22252b;color:#d8d9da;border:1px solid #464c54;border-radius:4px;text-decoration:none;font-size:13px;\">json level=error</a><a href=\"/d/platform-deployment?var-namespace=$namespace&var-deployment=$deployment&from=$__from&to=$__to&var-log_query=%7C%3D%20%22error%22\" style=\"padding:3px 12px;background:#22252b;color:#d8d9da;border:1px solid #464c54;border-radius:4px;text-decoration:none;font-size:13px;\">contains \"error\"</a><a href=\"/d/platform-deployment?var-namespace=$namespace&var-deployment=$deployment&from=$__from&to=$__to&var-log_query=%7C~%20%22timeout%7Crefused%7Cunreachable%22\" style=\"padding:3px 12px;background:#22252b;color:#d8d9da;border:1px solid #464c54;border-radius:4px;text-decoration:none;font-size:13px;\">network errors</a><a href=\"/d/platform-deployment?var-namespace=$namespace&var-deployment=$deployment&from=$__from&to=$__to&var-log_query=%7C%20json%20%7C%20duration%20%3E%201s\" style=\"padding:3px 12px;background:#22252b;color:#d8d9da;border:1px solid #464c54;border-radius:4px;text-decoration:none;font-size:13px;\">slow &gt;1s</a><a href=\"/d/platform-deployment?var-namespace=$namespace&var-deployment=$deployment&from=$__from&to=$__to&var-log_query=\" style=\"padding:3px 12px;background:#22252b;color:#ff7383;border:1px solid #464c54;border-radius:4px;text-decoration:none;font-size:13px;\">clear</a><span style=\"color:#8e8e8e;font-size:13px;margin-left:8px;\">current:</span><code>$log_query</code><span style=\"color:#666;font-size:12px;\">— free-form queries: panel menu → Explore</span></div>",
        "mode": "html"
      },
      "pluginVersion": "13.1.3",
      "title": "",
      "type": "text"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki_ds}"
      },
      "description": "Logs of the deployment's pods. The Log query variable is any LogQL pipeline applied after the namespace/pod selector (| json | level=\"error\", |= \"text\", …). Time range follows the dashboard picker; panel menu → Explore for arbitrary queries.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "id": 5,
      "options": {
        "enableLogDetails": false,
        "fullWidth": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "13.1.3",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_ds}"
          },
          "editorMode": "code",
          "expr": "{namespace=\"$namespace\", pod=~\"${pods:regexformat}\"} $log_query",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Recent logs",
      "type": "logs"
    }
  ],
  "preload": false,
  "refresh": "30s",
  "schemaVersion": 42,
