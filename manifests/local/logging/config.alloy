logging {
  level  = "info"
  // JSON logging: all platform components log JSON so log lines
  // are field-queryable (`| json` in LogQL) — alloy's own lines included
  format = "json"
}

// Node-local kube-apiserver audit logs (cmdshift/platform#90). Written on
// ctrl nodes under /var/log/audit/kube, rotated by the apiserver flags
// (maxSize 100MB / maxBackup 10 / maxAge 30). Events are already JSON — the
// normalize stage passes them through untouched. job="audit" is the query
// surface; node comes from the per-target label below. This runs on every
// alloy pod but only ctrl nodes have log files — file_match is idle elsewhere.
local.file_match "audit" {
  path_targets = [
    {
      __path__ = "/var/log/audit/kube/*.log",
      job      = "audit",
      // K8S_NODE_NAME is a downward API env (spec.nodeName) — more robust
      // than HOSTNAME, which mirrors the pod name
      node     = sys.env("K8S_NODE_NAME"),
    },
  ]
}

loki.source.file "audit" {
  targets    = local.file_match.audit.targets
  forward_to = [loki.process.normalize.receiver]
}

discovery.kubernetes "pods" {
  role = "pod"
}

// Promote k8s metadata to stream labels — this is the "query by property"
// pipeline: {namespace="x", pod=~"..."} selectors work natively now, and the
// HighErrorRate ruler alert groups by these labels. Cardinality is unchanged:
// namespace/pod/container are 1:1 with the existing instance label
// (ns/pod:container), and node is a function of pod.
discovery.relabel "k8s_labels" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label  = "node"
  }
}

loki.source.kubernetes "pods" {
  targets = discovery.relabel.k8s_labels.output
  // Normalize every line to JSON: lines already starting with "{" pass
  // through untouched (tetragon, and all components whose log-format knob is
  // set to json); everything else is parsed as logfmt and re-emitted as
  // {"field": "value", ...}. Lines that parse to nothing (plain text, e.g.
  // kubelet) keep their raw content under "msg" — lossless either way.
  // stage.template has all sprig functions (toJson/omit/dict); .Entry is the
  // raw line; .<key> are the extracted fields.
  forward_to = [loki.process.normalize.receiver]
}

loki.process "normalize" {
  forward_to = [loki.write.endpoint.receiver]

  // strip ANSI color codes before parsing — several components colorize and
  // the escapes end up embedded inside JSON string values otherwise
  stage.decolorize {}

  stage.match {
    selector      = "{job=~\".+\"} |~ \"^[^{]\""
    pipeline_name = "logfmt_to_json"

    stage.logfmt {
      regex = ".+"
    }

    stage.template {
      source   = "as_json"
      // If every extracted value is empty the "parse" was junk (plain-text
      // lines like kubelet/seaweed match logfmt-shaped junk keys) — emit the
      // raw line under "msg" so nothing is lost. Otherwise emit the fields.
      template = `{{ $clean := omit . "Entry" }}{{ $real := 0 }}{{ range $k, $v := $clean }}{{ if ne (toString $v) "" }}{{ $real = add $real 1 }}{{ end }}{{ end }}{{ if eq $real 0 }}{{ toJson (dict "msg" .Entry) }}{{ else }}{{ toJson $clean }}{{ end }}`
    }

    stage.output {
      source = "as_json"
    }
  }
}

loki.write "endpoint" {
  endpoint {
    url       = "http://loki.logging.svc:3100/loki/api/v1/push"
    tenant_id = "self-monitoring"
  }
}
