#!/usr/bin/env bash
# Reconcile from the root and poll until every kustomization is Ready,
# echoing progress (polling discipline: the reconcile-stuck skill).
#   flux_wait [max_polls] [--with-source]   # default 42; 5s sleep per poll
#   flux_wait -c                            # status check only — no
#                                           # reconcile, instant verdict
# --with-source (implied: the reconcile always includes it) is accepted in
# any position — documented invocations write both `flux_wait 15` and
# `flux_wait --with-source`. Exit 0 = all green. Exit 1 = failure or
# timeout, with the pending list + diagnose hint. Exit 2 = usage error (a
# non-integer or zero cap would silently disable the timeout). Exit 3 = the
# -c status check found groups still progressing.
#
# Poll loop: reconcile, sleep 5s (the reconcile is synchronous — flux has
# already applied by the time it returns; the sleep lets the tree start
# cascading), then poll. Each poll first greps for REAL failures: Ready=False
# with a message that is not a dependency-wait state. Dependency-wait
# messages are matched UNANCHORED as substrings ("is not ready",
# "revision is not up to date") — flux composes them freely
# ("dependency 'x/observability' revision is not up to date") and anchored
# regexes misclassified the composite as a real failure, aborting the loop
# mid-cascade (cmdshift/platform#58 session). A real failure never self-heals
# mid-poll (flux holds Ready=Unknown while a group progresses), so the loop
# exits on the first one with the diagnose hint instead of burning the
# remaining polls. Otherwise the pending list prints and the loop re-sleeps.
# Failing groups still print BEFORE the blocking reconcile (a failed group
# replays its cached error on every trigger).

DIAGNOSE="diagnose: kubectl -n flux-system describe kustomization <name> ; kubectl -n flux-system get events --sort-by=.lastTimestamp | tail -10"

usage() {
  echo "usage: flux_wait [-c] [max_polls] [--with-source]" >&2
  exit 2
}

reconcile() {
  flux reconcile kustomization local --with-source --timeout 4m 2>&1 | tail -1 || true
}

pending_kustomizations() {
  kubectl -n flux-system get kustomizations --no-headers 2>/dev/null \
    | awk '$3 != "True" {printf "%s ", $1}'
}

# one line per not-Ready group: "<name>: <reason or pending>"
group_states() {
  kubectl -n flux-system get kustomizations -o json 2>/dev/null | jq -r '
    .items[]
    | select(.status.conditions // [] | map(select(.type == "Ready" and .status == "True")) | length == 0)
    | (.metadata.name) + "|"
      + ((.status.conditions // []) | map(select(.type == "Ready")) | first | .message // "" )
    | gsub("\n"; " ")' | sort
}

print_states() {
  local states state
  states="$(group_states)"
  if [ -z "$states" ]; then
    return 1
  fi
  while IFS= read -r state; do
    local name="${state%%|*}" msg="${state#*|}"
    if [ -n "$msg" ]; then
      echo "  $name: $msg"
    else
      echo "  $name: progressing/pending"
    fi
  done <<< "$states"
  return 0
}

# dependency-wait states self-heal the moment the dependency lands — they are
# pending, not failure. Matched as unanchored substrings: flux composes the
# two phrasings into one message ("dependency 'x/y' revision is not up to
# date") and an anchored match on either alone misclassifies it.
is_dependency_wait() {
  case "$1" in
    *"is not ready"*|*"revision is not up to date"*) return 0 ;;
    *) return 1 ;;
  esac
}

# prints real failing groups' messages; rc 0 if any Ready=False that is NOT
# a dependency-wait state (see is_dependency_wait)
failures() {
  local states state name msg
  states="$(group_states)" || return 1
  local out=""
  while IFS= read -r state; do
    name="${state%%|*}" msg="${state#*|}"
    # Ready=False with an empty message is a transitioning group, not a real
    # failure — classified as pending
    if [ -n "$msg" ] && ! is_dependency_wait "$msg"; then
      out+="${out:+ ;; }$name: ${msg:-<no message>}"
    fi
  done <<< "$states"
  [ -n "$out" ] && printf '%s\n' "$out"
}

wait_for_green() {
  local max="$1" n=0 failed
  while :; do
    failed="$(failures)"
    if [ -n "$failed" ]; then
      echo "flux_wait: failed: $failed"
      echo "$DIAGNOSE"
      return 1
    fi
    local pending
    pending="$(pending_kustomizations)"
    if [ -z "$pending" ]; then
      local total
      total=$(kubectl -n flux-system get kustomizations --no-headers | wc -l | tr -d ' ')
      echo "flux_wait: all $total kustomizations Ready"
      return 0
    fi
    n=$((n + 1))
    if [ "$n" -ge "$max" ]; then
      echo "flux_wait: TIMEOUT after $max polls — pending: $pending"
      echo "$DIAGNOSE"
      return 1
    fi
    echo "[$n/$max] pending: $pending"
    sleep 5
  done
}

flux_wait() {
  local check_only=false max=42 arg
  while [ $# -gt 0 ]; do
    case "$1" in
      -c) check_only=true ;;
      --with-source) ;; # implied — reconcile() always reconciles --with-source
      ''|*[!0-9]*|0) usage ;;
      *) max="$1" ;;
    esac
    shift
  done

  if $check_only; then
    if print_states; then
      exit 3
    fi
    local total
    total=$(kubectl -n flux-system get kustomizations --no-headers 2>/dev/null | wc -l | tr -d ' ')
    echo "flux_wait: all $total kustomizations Ready"
    exit 0
  fi

  # pre-trigger snapshot: failing groups replay their cached error on every
  # trigger — surface it before the blocking reconcile, not after
  local failed
  failed="$(failures)"
  [ -n "$failed" ] && echo "current: failed: $failed"

  reconcile
  sleep 5
  wait_for_green "$max"
}

flux_wait "$@"
