#!/usr/bin/env bash
# Reconcile from the root and poll until every kustomization is Ready,
# echoing progress (see AGENTS.md polling discipline).
#   flux_wait [max_polls] [--with-source]   # 10s per poll; default 42 (~7m)
#   flux_wait -c                            # status check only — no
#                                           # reconcile, instant verdict
# --with-source (implied: the reconcile always includes it) is accepted in
# any position — documented invocations write both `flux_wait 15` and
# `flux_wait --with-source`. Exit 0 = all green. Exit 1 = failure or
# timeout, with the pending list + diagnose hint. Exit 2 = usage error (a
# non-integer or zero cap would silently disable the timeout). Exit 3 = the
# -c status check found groups still progressing.
#
# Fast-fail philosophy (same as helm_wait): Ready=False with a *real error*
# is a failed attempt, not slowness — flux holds Ready=Unknown while a group
# progresses, so a real failure never self-heals mid-poll, and the poll loop
# exits on the first one instead of burning the remaining polls. Exception:
# flux reports dependency-waiting as Ready=False too ("dependency '...' is
# not ready", "revision is not up to date") — those are the normal
# tree-cascade states and self-heal the moment the dependency lands, so they
# are classified as pending, not failure (otherwise every artifact bump
# fast-fails mid-cascade). Classification is by message pattern (no separate
# waiting condition type exists). Failing groups still print BEFORE the
# blocking reconcile (a failed group replays its cached error on every
# trigger).

DIAGNOSE="diagnose: kubectl -n flux-system describe kustomization <name> ; kubectl -n flux-system get events --sort-by=.lastTimestamp | tail -10"

usage() {
  echo "usage: flux_wait [-c] [max_polls] [--with-source]" >&2
  exit 2
}

reconcile() {
  flux reconcile kustomization local --with-source --timeout 4m 2>&1 | tail -1 || true
}

pending_kustomizations() {
  kubectl -n flux-system get kustomizations --no-headers 2>/dev/null \
    | awk '$3 != "True" {printf "%s ", $1}'
}

# one line per not-Ready group: "<name>: <reason or pending>"
group_states() {
  kubectl -n flux-system get kustomizations -o json 2>/dev/null | jq -r '
    .items[]
    | select(.status.conditions // [] | map(select(.type == "Ready" and .status == "True")) | length == 0)
    | (.metadata.name) + "|"
      + ((.status.conditions // []) | map(select(.type == "Ready")) | first | .message // "" )
    | gsub("\n"; " ")' | sort
}

print_states() {
  local states state
  states="$(group_states)"
  if [ -z "$states" ]; then
    return 1
  fi
  while IFS= read -r state; do
    local name="${state%%|*}" msg="${state#*|}"
    if [ -n "$msg" ]; then
      echo "  $name: $msg"
    else
      echo "  $name: progressing/pending"
    fi
  done <<< "$states"
  return 0
}

# prints failing groups' messages; rc 0 if any Ready=False that is NOT a
# dependency-wait state (those are pending — see the header comment)
failures() {
  kubectl -n flux-system get kustomizations -o json 2>/dev/null | jq -re '
    [ .items[]
      | select((.status.conditions // [])
        | any(.type == "Ready" and .status == "False"))
      | select((((.status.conditions // [])
        | map(select(.type == "Ready")) | first | .message // "")
        | test("^dependency .* is not ready$|^revision is not up to date$")) | not) ]
    | if length > 0 then
        map((.metadata.name) + ": "
          + ((.status.conditions // [])
             | map(select(.type == "Ready")) | first | .message // "<no message>")
          | gsub("\n"; " "))
        | join(" ;; ")
      else empty end' 2>/dev/null
}

wait_for_green() {
  local max="$1" n=0 failed
  while :; do
    failed="$(failures)"
    if [ -n "$failed" ]; then
      echo "flux_wait: failed: $failed"
      echo "$DIAGNOSE"
      return 1
    fi
    local pending
    pending="$(pending_kustomizations)"
    if [ -z "$pending" ]; then
      local total
      total=$(kubectl -n flux-system get kustomizations --no-headers | wc -l | tr -d ' ')
      echo "flux_wait: all $total kustomizations Ready"
      return 0
    fi
    n=$((n + 1))
    if [ "$n" -ge "$max" ]; then
      echo "flux_wait: TIMEOUT after $max polls — pending: $pending"
      echo "$DIAGNOSE"
      return 1
    fi
    echo "[$n/$max] pending: $pending"
    sleep 10
  done
}

flux_wait() {
  local check_only=false max=42 arg
  while [ $# -gt 0 ]; do
    case "$1" in
      -c) check_only=true ;;
      --with-source) ;; # implied — reconcile() always reconciles --with-source
      ''|*[!0-9]*|0) usage ;;
      *) max="$1" ;;
    esac
    shift
  done

  if $check_only; then
    if print_states; then
      exit 3
    fi
    local total
    total=$(kubectl -n flux-system get kustomizations --no-headers 2>/dev/null | wc -l | tr -d ' ')
    echo "flux_wait: all $total kustomizations Ready"
    exit 0
  fi

  # pre-trigger snapshot: failing groups replay their cached error on every
  # trigger — surface it before the blocking reconcile, not after
  local failed
  failed="$(failures)"
  [ -n "$failed" ] && echo "current: failed: $failed"

  reconcile
  wait_for_green "$max"
}

flux_wait "$@"
