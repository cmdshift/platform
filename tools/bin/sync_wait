#!/usr/bin/env bash
# Wait until locally-changed manifests have actually landed in the flux
# bucket — run BEFORE flux_wait. The sync container mirrors via inotify and
# drops events (documented in AGENTS.md; hit live twice on plain
# edits) — a reconcile against a stale artifact fails confusingly or, for a
# helm release, churns upgrade/rollback cycles.
#
#   sync_wait                  # wait for every uncommitted change under manifests/
#   sync_wait <path>...        # wait for specific files (repo-relative or absolute)
#
# Compares sha256 of each local file against `rustfs cat main/flux/<path>`
# (deleted files: converged when the bucket object is gone). Bounded poll
# (SYNC_WAIT_TIMEOUT, default 120s) echoing progress; exit 0 = converged,
# 1 = timeout (still-stale files listed + restart hint), 2 = usage.
#
# Nothing to do (no changes) exits 0 immediately.

set -euo pipefail

TIMEOUT="${SYNC_WAIT_TIMEOUT:-120}"
REPO=$(git rev-parse --show-toplevel)

declare -a PATHS=()
declare -A WANT # path -> local sha256; "" = deleted locally

usage() {
  echo "usage: sync_wait [path]...   # files only (repo-relative or absolute); default: uncommitted changes under manifests/" >&2
  exit 2
}

collect_paths() { # explicit args, else uncommitted changes under manifests/
  local p
  if [[ $# -gt 0 ]]; then
    for p in "$@"; do
      case "$p" in
        /*) PATHS+=("${p#"$REPO"/}") ;;
        *) PATHS+=("$p") ;;
      esac
    done
  else
    while IFS= read -r f; do PATHS+=("$f"); done < <(git status --porcelain -- manifests/ \
      | awk '{
          status=$1; $1=""; sub(/^ +/, "")
          if (status ~ /^R/) {
            # porcelain prints "old -> new" — track BOTH: the new path as
            # content to converge, the old path as a deletion (bucket object
            # gone); treating the arrow line as one path hangs until timeout
            if (match($0, / -> /)) { print substr($0, RSTART+RLENGTH); print substr($0, 1, RSTART-1) }
            next
          }
          if (status == "D" || status == "M" || status == "A") print
          else if (status == "??" && $0 !~ /\/$/) print
        }')
  fi
}

load_hashes() { # validate PATHS, fill WANT — a wrong path here hangs the poll
  local p
  for p in "${PATHS[@]}"; do
    if [[ -f "$REPO/$p" ]]; then
      WANT[$p]=$(sha256sum "$REPO/$p" | awk '{print $1}')
    elif [[ -d "$REPO/$p" ]]; then
      echo "sync_wait: $p is a directory — pass files (the default mode covers dirs via git status)" >&2
      usage
    elif git cat-file -e "HEAD:$p" 2>/dev/null; then
      WANT[$p]="" # deleted locally — converged when the bucket object is gone
    else
      echo "sync_wait: no such file (tracked or working tree): $p" >&2
      usage
    fi
  done
}

stale() { # print paths whose bucket object doesn't match the local hash
  local p h remote
  for p in "${!WANT[@]}"; do
    h="${WANT[$p]}"
    remote=$(rustfs cat "main/flux/$p" 2>/dev/null | sha256sum | awk '{print $1}') || remote=""
    [[ "$remote" == "$h" ]] || echo "$p"
  done
}

sync_wait() {
  collect_paths "$@"
  [[ ${#PATHS[@]} -gt 0 ]] || { echo "nothing changed under manifests/ — bucket sync is a no-op"; exit 0; }
  load_hashes

  local pending
  local START
  START=$(date +%s)
  while true; do
    pending=$(stale | sort)
    if [[ -z "$pending" ]]; then
      echo "sync_wait: bucket matches working tree (${#WANT[@]} file(s))"
      exit 0
    fi
    if (( $(date +%s) - START > TIMEOUT )); then
      echo "sync_wait: TIMEOUT after ${TIMEOUT}s — still stale in bucket:"
      sed 's/^/  /' <<< "$pending"
      echo "hint: docker restart sync-cloud-test forces a full re-mirror (runbooks/local/pipeline-wedged.md)"
      exit 1
    fi
    echo "sync_wait: waiting on $(wc -l <<< "$pending") file(s): $(tr '\n' ' ' <<< "$pending")"
    sleep 5
  done
}

sync_wait "$@"
