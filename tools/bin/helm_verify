#!/usr/bin/env bash
# Render every HelmRelease's values through `helm template` — the values-path
# verification step (catches bad values keys/paths before flux ships them to
# the cluster).
#   helm_verify                    # full tree: every group overlay (~25s)
#   helm_verify '' <release>       # full tree, just that release
#   helm_verify <path> [release]   # one dir or file; a group overlay is
#                                  # manifests/clusters/local/<group>
# Full tree: each child dir of $HELM_VERIFY_ROOT (default
# manifests/clusters/local) holding a kustomization.yaml is built and
# verified on its own, exactly like an explicit run on that dir — the root
# itself is never built (an explicit path that IS the root runs the full
# tree too). Helm homes and chart sources are set up once per run.
# Values sources, merged in flux order (inline first, valuesFrom refs after —
# later files override earlier ones):
#   - spec.values (inline in the HelmRelease)
#   - spec.valuesFrom ConfigMap refs, resolved from the rendered resources:
#       a path with a kustomization.yaml is built with `kubectl kustomize` and
#       each ref matches the built ConfigMap's metadata.name (data key
#       extracted; flux ships the build output, so name refs/hash suffixes
#       are inherited); single-file / ad-hoc paths without a kustomization
#       fall back to same-dir configMapGenerator entries (the referenced
#       file is a plain values doc, e.g. `values.yaml=trivy-values.yaml`) or a
#       literal kind: ConfigMap manifest with a matching name.
#       A ref with no matching ConfigMap is a FAIL, not a skip.
# Chart sources resolve from the live cluster's source CRs
# (`kubectl get helmrepo,gitrepo -n flux-system`): HelmRepository →
# `helm repo add` + template from the repo index; OCI HelmRepository
# (`oci://` url) → `helm pull` of the exact chart/version tag (the tag IS the
# version — a typo'd pin fails loudly instead of falling back); GitRepository
# (tag or commit ref) → shallow clone + template from the chart subpath. All
# helm state lives in a temp dir — the user's helm home/cache is untouched.
#
# Prints PASS/FAIL per release (full tree: a `== <group dir>: N releases`
# line per group, then a TOTAL line); the last line is the verdict. Exit 1
# if any release fails, a source CR is missing, a pinned version isn't in
# the repo index (helm's fallback would silently render the closest version
# instead — diagnose hint printed), a kustomize build fails (full tree: that
# group FAILs, the rest still run), a named release matches nothing, or a
# full-tree run renders 0 releases. An explicit path with no HelmRelease is
# an `OK: 0 releases` notice, exit 0. Exit 2 = usage error.
#
# Gotcha: helm template rejects unknown values keys only for charts that
# ship a values.schema.json (kube-prometheus-stack does; most don't) — for
# schema-less charts this catches nil-pointer template errors, not key
# typos. Cross-check surprise changes against the upstream values.yaml.

set -uo pipefail

DEFAULT_ROOT="manifests/clusters/local"
path="" filter="" fail=0 count=0 failed=0
tmp="" SOURCES="" kube_args=() VFILES=() releases=""

usage() {
  echo "usage: helm_verify [path] [release]   ('' or no path = full tree; --help)" >&2
  exit 2
}

help() { # print the header comment block
  awk 'NR==1 {next} /^#/ {sub(/^# ?/,""); print; next} {exit}' "$0"
}

# --- source CRs from the cluster: name<TAB>kind<TAB>url<TAB>ref-type<TAB>ref ---
load_sources() {
  {
    kubectl get helmrepo -A -o json 2>/dev/null | jq -r --arg k HelmRepository \
      '.items[] | [.metadata.name, $k, .spec.url, "-", "-"] | @tsv'
    kubectl get gitrepo -A -o json 2>/dev/null | jq -r --arg k GitRepository \
      '.items[] | [.metadata.name, $k, .spec.url, (.spec.ref // {} | to_entries[0].key // "-"), (.spec.ref // {} | to_entries[0].value // "-")] | @tsv'
  } > "$SOURCES"
  [[ -s "$SOURCES" ]] || { echo "FAIL: no HelmRepository/GitRepository CRs found — is the cluster up?"; exit 1; }
}

git_checkout() { # url reftype refvalue dest
  local url="$1" reftype="$2" ref="$3" dest="$4"
  # tag refs check out detached — silence git's advice noise
  if [[ "$reftype" == "commit" ]]; then
    git -c advice.detachedHead=false init -q "$dest" && git -C "$dest" remote add origin "$url" &&
      git -C "$dest" fetch -q --depth 1 origin "$ref" && git -C "$dest" checkout -q FETCH_HEAD
  else
    git -c advice.detachedHead=false clone -q --depth 1 --branch "$ref" "$url" "$dest"
  fi
}

# resolve a valuesFrom ConfigMap ref from the kustomize build output; empty
# output = unresolved (a `null` data value — CM exists but lacks the key —
# counts as unresolved too: helm would get an empty values file silently)
resolve_cm_from_build() { # refname refkey -> echo values file; empty = unresolved
  local rname="$1" rkey="$2"
  # -o=json emits the data value as a JSON string (data keys are scalar
  # strings, even when the value is a YAML doc) — jq -r decodes it back to
  # the raw text helm expects
  yq eval-all -o=json 'select(.kind == "ConfigMap" and .metadata.name == "'"$rname"'") | .data["'"$rkey"'"] | select(. != null)' "$tmp/build.yaml" \
    | jq -r '.' > "$tmp/cm-$rname.yaml"
  [[ -s "$tmp/cm-$rname.yaml" ]] && echo "$tmp/cm-$rname.yaml"
}

# resolve a valuesFrom ConfigMap ref to a local values file; empty output = unresolved
resolve_cm_values() { # reldir refname refkey
  local dir="$1" rname="$2" rkey="$3" entry src=""
  if [[ -f "$dir/kustomization.yaml" ]]; then
    entry=$(yq ".configMapGenerator[]? | select(.name == \"$rname\") | .files[]" "$dir/kustomization.yaml" 2>/dev/null \
      | while IFS= read -r e; do
          k="${e%%=*}"; v="${e#*=}"
          if [[ "$e" == *=* ]]; then [[ "$k" == "$rkey" ]] && echo "$v";
          else [[ "$e" == "$rkey" ]] && echo "$e"; fi
        done | head -1)
    [[ -n "$entry" && -f "$dir/$entry" ]] && src="$dir/$entry"
  fi
  if [[ -z "$src" ]]; then
    # fallback: a literal ConfigMap manifest — extract the data key
    for c in $(grep -rl --include='*.yaml' 'kind: ConfigMap' "$path" 2>/dev/null | sort); do
      if yq -e 'select(.kind == "ConfigMap" and .metadata.name == "'"$rname"'")' "$c" >/dev/null 2>&1; then
        yq 'select(.kind == "ConfigMap" and .metadata.name == "'"$rname"'") | .data["'"$rkey"'"]' "$c" > "$tmp/cm-$rname.yaml"
        [[ -s "$tmp/cm-$rname.yaml" ]] && src="$tmp/cm-$rname.yaml"
        break
      fi
    done
  fi
  [[ -n "$src" ]] && echo "$src"
}

source_url() { # srcKind srcName -> chart-source url; empty when the CR is missing
  awk -F'\t' -v n="$2" -v k="$1" '$1==n && $2==k {print $3; exit}' "$SOURCES"
}

git_source_ref() { # srcName -> "reftype refvalue" of its GitRepository
  awk -F'\t' -v n="$1" '$1==n && $2=="GitRepository" {print $4, $5; exit}' "$SOURCES"
}

repo_present() { # name url -> rc 0 when the repo is registered with this url
  helm repo list -o json 2>/dev/null | jq -e --arg n "$1" --arg u "$2" \
    '.[] | select(.name == $n and .url == $u)' >/dev/null
}

chart_in_index() { # repo chart [version] -> rc 0 when the local index knows the
                   # chart (and the pinned version, when given; v-prefix normalized).
                   # --devel: prerelease pins (cilium 1.21.0-pre.x) are hidden
                   # from plain `helm search repo` but resolve fine in flux
  local versions
  versions=$(helm search repo "$1/$2" --versions --devel -o json 2>/dev/null) || return 1
  if [[ -z "${3:-}" ]]; then
    [ "$(jq 'length' <<< "$versions")" -gt 0 ]
  else
    jq -r --arg want "${3#v}" '.[].version | sub("^v";"") | select(. == $want)' <<< "$versions" | grep -q .
  fi
}

oci_pull_ref() { # oci-url chart version -> echo pulled tgz path; on failure
                 # echo the reason, rc 1. Cached per (chart, version) run-wide.
  local base="${1%/}" ref dest="$tmp/oci-$2-$3.tgz"
  ref="$base/$2"
  if [[ ! -s "$dest" ]]; then
    helm pull "$ref" --version "$3" --destination "$tmp" >/dev/null 2>&1 \
      || { echo "helm pull $ref --version $3 failed (OCI tag missing? registry unreachable?)"; return 1; }
    if [[ -f "$tmp/$2-$3.tgz" ]]; then
      mv "$tmp/$2-$3.tgz" "$dest"
    else
      echo "helm pull $ref wrote no expected $2-$3.tgz"
      return 1
    fi
  fi
  echo "$dest"
}

chart_ref() { # srcKind srcName chart version -> echo usable helm ref; on
              # failure echo the reason (main prefixes "FAIL: <release> — ")
              # and exit 1
  local url reftype refval clone
  url=$(source_url "$1" "$2")
  if [[ -z "$url" ]]; then
    echo "source $1/$2 not found on cluster (check sources.yaml apply state)"
    return 1
  fi
  if [[ "$1" == "HelmRepository" && "$url" == oci://* ]]; then
    local tgz
    tgz=$(oci_pull_ref "$url" "$3" "$4") || { echo "$tgz"; return 1; }
    echo "$tgz"
    return 0
  fi
  if [[ "$1" == "HelmRepository" ]]; then
    # fetch only on a miss: the probe (chart_in_index) answers from the local
    # index, so each unique repo is fetched at most once per run — a re-fetch
    # per release both wastes the network and widens the window for the
    # transient stale-index reads this flow used to hit (external-secrets
    # FAILED a full run with 2.10.0 very much in the upstream index). A miss
    # triggers exactly one scoped `helm repo update` before failing — and a
    # failed add/update is a FAIL, not a swallowed `|| true`.
    if ! repo_present "$2" "$url"; then
      helm repo add "$2" "$url" --force-update >/dev/null 2>&1 || { echo "helm repo add $2 ($url) failed"; return 1; }
    fi
    if ! chart_in_index "$2" "$3" "$4"; then
      helm repo update "$2" >/dev/null 2>&1 || { echo "helm repo update $2 failed (transient network?)"; return 1; }
      if ! chart_in_index "$2" "$3" "$4"; then
        # helm's --version falls back to the CLOSEST index version with only
        # a warning — a typo'd pin would render a different chart than flux
        # deploys and still PASS. The leading v is normalized on both sides
        # (indexes publish v1.2.3 where HelmReleases pin 1.2.3 — flux resolves
        # the same way via semver constraints).
        echo "version $4 not in $2 index (helm would silently render the closest available version)"
        return 1
      fi
    fi
    echo "$2/$3"
    return 0
  fi
  read -r reftype refval < <(git_source_ref "$2")
  clone="$tmp/git-$2"
  if [[ ! -d "$clone" ]] && ! git_checkout "$url" "$reftype" "$refval" "$clone"; then
    echo "git clone $2 ($reftype $refval) failed"
    return 1
  fi
  echo "$clone/$3"
}

collect_values() { # file name -> VFILES (inline first, then valuesFrom refs in
                   # declared order); exit 1 when a valuesFrom ref has no local
                   # source (all missing refs are reported first)
  local f="$1" name="$2" rname rkey src unresolved=0
  VFILES=() # per-release: leaks here flow into the NEXT release's render
  local inline="$tmp/values-$name-inline.json"
  yq eval-all -o=json 'select(.kind == "HelmRelease" and .metadata.name == "'"$name"'") | .spec.values // {}' "$f" > "$inline"
  [[ -s "$inline" ]] || echo '{}' > "$inline"
  VFILES+=("$inline")
  while IFS=$'\t' read -r rname rkey; do
    [[ -z "$rname" ]] && continue
    if [[ -s "${tmp:-}/build.yaml" ]]; then
      src=$(resolve_cm_from_build "$rname" "$rkey")
    else
      src=$(resolve_cm_values "$(dirname "$f")" "$rname" "$rkey")
    fi
    if [[ -z "$src" ]]; then
      echo "FAIL: $name — valuesFrom ConfigMap/$rname (key '$rkey') has no matching ConfigMap in the kustomize build output (or local source for single-file mode)"
      unresolved=1
    else
      VFILES+=("$src")
    fi
  done < <(yq eval-all 'select(.kind == "HelmRelease" and .metadata.name == "'"$name"'") | .spec.valuesFrom[]? | select(.kind == "ConfigMap") | [.name, (.valuesKey // "values.yaml")] | @tsv' "$f")
  return "$unresolved"
}

render_release() { # file name ns chart version srcKind srcName -> PASS/FAIL line; rc 1 = FAIL
  local f="$1" name="$2" ns="$3" chart="$4" version="$5" srcKind="$6" srcName="$7"
  local ref err v
  ref=$(chart_ref "$srcKind" "$srcName" "$chart" "$version") || { echo "FAIL: $name — $ref"; return 1; }
  collect_values "$f" "$name" || return 1
  local args=("$ref" --namespace "$ns" "${kube_args[@]}")
  for v in "${VFILES[@]}"; do args+=(-f "$v"); done
  [[ -n "$version" && "$srcKind" == "HelmRepository" && ! -f "$ref" ]] && args+=(--version "$version")
  if err=$(helm template "$name" "${args[@]}" 2>&1 >/dev/null); then
    echo "PASS: $name ($chart${version:+ $version})"
  else
    echo "FAIL: $name ($chart${version:+ $version})"
    sed 's/^/  /' <<< "$err" | head -15
    return 1
  fi
}

setup_env() { # temp helm homes, chart sources, kube version — once per run
  command -v helm >/dev/null || { echo "FAIL: helm not installed"; exit 1; }
  local git_root kubever
  git_root=$(git rev-parse --show-toplevel)
  tmp=$(mktemp -d "$git_root/.agents/temp/helm_verify.XXXXXX")
  SOURCES="$tmp/sources.tsv"
  trap 'rm -rf "$tmp"' EXIT
  export HELM_CACHE_HOME="$tmp/cache" HELM_CONFIG_HOME="$tmp/config" HELM_DATA_HOME="$tmp/data"
  export HELM_REPOSITORY_CACHE="$tmp/cache/repository"
  load_sources
  kubever=$(kubectl version -o json 2>/dev/null | jq -r '.serverVersion.gitVersion // empty')
  kube_args=(); [[ -n "$kubever" ]] && kube_args=(--kube-version "$kubever")
}

find_releases() { # path -> releases (the build output for a kustomize dir,
                  # else the HelmRelease files under path); rc 1 = build failed
  releases=""
  rm -f "$tmp/build.yaml"
  if [[ -d "$1" && -f "$1/kustomization.yaml" ]]; then
    if ! kubectl kustomize "$1" > "$tmp/build.yaml" 2>"$tmp/build.err"; then
      echo "FAIL: kustomize build of $1 failed:"
      sed 's/^/  /' "$tmp/build.err"
      rm -f "$tmp/build.yaml"
      return 1
    fi
    if yq eval-all -e 'select(.kind == "HelmRelease")' "$tmp/build.yaml" >/dev/null 2>&1; then
      releases="$tmp/build.yaml"
    fi
  else
    releases=$(grep -rl --include='*.yaml' 'kind: HelmRelease' "$1" 2>/dev/null | sort)
  fi
}

release_rows() { # -> file<TAB>name<TAB>ns<TAB>chart<TAB>version<TAB>srcKind<TAB>srcName
                 # per HelmRelease in $releases, narrowed to $filter when set
  local f
  for f in $releases; do
    yq eval-all -o=json 'select(.kind == "HelmRelease") | [{"name": .metadata.name, "ns": .metadata.namespace, "chart": .spec.chart.spec.chart, "version": (.spec.chart.spec.version // ""), "srcKind": (.spec.chart.spec.sourceRef.kind // ""), "srcName": (.spec.chart.spec.sourceRef.name // "")}]' "$f" \
      | jq -r --arg f "$f" '.[] | [$f, .name, .ns, .chart, .version, .srcKind, .srcName] | @tsv'
  done | awk -F'\t' -v want="$filter" 'want == "" || $2 == want'
}

render_rows() { # release rows on fd 3 -> PASS/FAIL per release; updates count/failed/fail
  local f name ns chart version srcKind srcName
  while IFS=$'\t' read -r -u 3 f name ns chart version srcKind srcName; do
    [[ -n "$name" ]] || continue
    count=$((count + 1))
    render_release "$f" "$name" "$ns" "$chart" "$version" "$srcKind" "$srcName" \
      || { failed=$((failed + 1)); fail=1; }
  done
}

verify_path() { # path -> exit; one dir or file, verified as given
  local rows
  path="$1"
  find_releases "$path" || exit 1
  rows=$(release_rows)
  if [[ -z "$rows" ]]; then
    [[ -z "$filter" ]] || { echo "FAIL: no HelmRelease named '$filter' under $path"; exit 1; }
    echo "OK: 0 releases — no 'kind: HelmRelease' found under $path"
    exit 0
  fi
  render_rows 3<<< "$rows"
  if [[ "$fail" -eq 0 ]]; then
    echo "OK: $count releases render clean"
  else
    echo "FAILED releases above — fix before reconciling (values land verbatim in helm-controller)"
  fi
  exit "$fail"
}

verify_group() { # group dir -> "== <dir>: N releases" + PASS/FAIL lines; rc 1 = build
                 # failed. With a filter, a group without a match prints nothing.
  local rows n
  path="$1"
  find_releases "$path" || return 1
  rows=$(release_rows)
  [[ -z "$rows" && -n "$filter" ]] && return 0
  n=$(grep -c . <<< "$rows")
  echo "== $path: $n releases"
  render_rows 3<<< "$rows"
}

tree_summary() { # root groups broken -> TOTAL + verdict lines; exit 1 on any FAIL or 0 releases
  local root="$1" groups="$2" broken="$3"
  echo "TOTAL: $count releases ($failed failed) across $groups group overlays ($broken builds failed) under $root"
  if [[ "$count" -eq 0 ]]; then
    if [[ -n "$filter" ]]; then
      echo "FAIL: no HelmRelease named '$filter' in any group overlay under $root"
    else
      echo "FAIL: 0 releases rendered — a full-tree run must render at least one (wrong HELM_VERIFY_ROOT? every group build failed?)"
    fi
    exit 1
  fi
  if [[ "$fail" -eq 0 ]]; then
    echo "OK: $count releases render clean across $groups group overlays"
  else
    echo "FAILED releases/builds above — fix before reconciling (values land verbatim in helm-controller; a failed build wedges flux too)"
  fi
  exit "$fail"
}

verify_tree() { # root -> exit; every child dir with a kustomization.yaml, one build each
  local root="${1%/}" d groups=0 broken=0
  for d in "$root"/*/; do
    [[ -f "${d}kustomization.yaml" ]] || continue
    groups=$((groups + 1))
    verify_group "${d%/}" || { broken=$((broken + 1)); fail=1; }
  done
  [[ "$groups" -gt 0 ]] || { echo "FAIL: no group overlays (child dirs with a kustomization.yaml) under $root"; exit 1; }
  tree_summary "$root" "$groups" "$broken"
}

helm_verify() {
  case "${1:-}" in -h|--help) help; exit 0 ;; esac
  [ $# -le 2 ] || usage
  local root="${HELM_VERIFY_ROOT:-$DEFAULT_ROOT}" target="${1:-}"
  filter="${2:-}"
  if [[ -z "$target" ]]; then
    [[ -d "$root" ]] || { echo "helm_verify: no such dir: $root (HELM_VERIFY_ROOT)" >&2; usage; }
  else
    [ -e "$target" ] || { echo "helm_verify: no such path: $target" >&2; usage; }
  fi
  setup_env
  if [[ -z "$target" || ( -d "$root" && "$target" -ef "$root" ) ]]; then
    verify_tree "$root"
  else
    verify_path "$target"
  fi
}

helm_verify "$@"
