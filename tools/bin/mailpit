#!/usr/bin/env bash
# Mailpit (where alert emails land): newest subjects, a subject search across
# ALL messages, or a full body.
#   mailpit [limit]              # "<id>  <subject>" of the newest messages, default 10
#   mailpit -q <subject> [limit] # "<created> <id> <subject>" of messages whose subject
#                                # contains <subject>, ALL messages, newest first, default 20
#   mailpit -s <subject>         # newest message whose subject contains <subject> → id + body
#   mailpit -b <id>              # body (text if present, else HTML), CR stripped
# Subject matching is mailpit's search (case-insensitive substring).
# Exit 0 = fetched, 1 = not found / no match, 2 = usage error,
# 3 = mailpit API unreachable or answered non-JSON.

set -euo pipefail

MAILPIT=http://mail.cloud.test

usage() {
  echo "usage: mailpit [limit] | mailpit -q <subject-substring> [limit] | mailpit -s <subject-substring> | mailpit -b <id>" >&2
  exit 2
}

help() { # print the header comment block
  awk 'NR==1 {next} /^#/ {sub(/^# ?/,""); print; next} {exit}' "$0"
}

positive_int() { # value — usage error unless a positive integer (it goes into the API query string)
  case "$1" in ''|*[!0-9]*) usage ;; esac
  [ "$1" -gt 0 ] || usage
}

api_json() { # url — JSON body on stdout; exit 3 when mailpit is unreachable or answers non-JSON
  local body
  body=$(curl -s --max-time 10 "$1") || { echo "mailpit unreachable at $MAILPIT" >&2; exit 3; }
  jq -e . >/dev/null 2>&1 <<<"$body" || { echo "mailpit answered non-JSON for $1" >&2; exit 3; }
  printf '%s\n' "$body"
}

search() { # subject limit — search API JSON; the phrase is quoted so multi-word subjects match
  local q
  q=$(jq -rn --arg q "subject:\"$1\"" '$q|@uri')
  api_json "$MAILPIT/api/v1/search?query=$q&limit=$2"
}

list_newest() { # limit
  local json
  json=$(api_json "$MAILPIT/api/v1/messages?limit=$1")
  jq -r '.messages[]? | "\(.ID)  \(.Subject[0:120])"' <<<"$json"
}

search_list() { # subject limit
  local json out
  json=$(search "$1" "$2")
  out=$(jq -r '.messages[]? | "\(.Created) \(.ID) \(.Subject)"' <<<"$json")
  [ -n "$out" ] || { echo "no message matching '$1'" >&2; exit 1; }
  printf '%s\n' "$out"
}

body() { # id — text if present, else HTML; CR stripped (mailpit bodies are CRLF)
  local out code
  out=$(curl -s --max-time 10 -w '\n%{http_code}' "$MAILPIT/api/v1/message/$1") \
    || { echo "mailpit unreachable at $MAILPIT" >&2; exit 3; }
  code=${out##*$'\n'}
  out=${out%$'\n'*}
  [ "$code" = 200 ] || { echo "no message $1" >&2; exit 1; }
  # jq -r prints nulls as "null"; prefer text, fall back to html
  printf '%s' "$out" | jq -r 'if .Text != "" then .Text else .HTML end' | tr -d '\r'
}

newest_match() { # subject — id + body of the newest match across all messages
  local json id
  json=$(search "$1" 1)
  id=$(jq -r '.messages[0].ID // empty' <<<"$json")
  [ -n "$id" ] || { echo "no message matching '$1'" >&2; exit 1; }
  echo "id: $id"
  body "$id"
}

mailpit() {
  case "${1:-}" in -h|--help) help; exit 0 ;; esac
  case "${1:-}" in
    -b) [ $# -eq 2 ] && [ -n "$2" ] || usage; body "$2" ;;
    -s) [ $# -eq 2 ] && [ -n "$2" ] || usage; newest_match "$2" ;;
    -q) [ $# -ge 2 ] && [ $# -le 3 ] && [ -n "$2" ] || usage
        local limit=${3:-20}; positive_int "$limit"; search_list "$2" "$limit" ;;
    -*) usage ;;
    *)  [ $# -le 1 ] || usage
        local limit=${1:-10}; positive_int "$limit"; list_newest "$limit" ;;
  esac
}

mailpit "$@"
