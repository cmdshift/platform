#!/usr/bin/env bash
# Unstick kyverno rollouts deadlocked on hostNetwork ports.
#   kyverno_unblock
# LOCAL-ONLY: hostNetwork is a talos-in-docker setting (the "remove in the
# cloud" values in kyverno.helm-release.yaml). Each kyverno pod claims its
# node's port, so every worker can host exactly one pod per controller — a
# new-generation pod stays Pending until the old one is gone (AGENTS.md
# kyverno landmine). Deletes the old-generation REPLICA SETS.
#
# this tool used to delete old-generation PODS — that's
# whack-a-mole. The stale RS still wants its replicas, so it respawns a
# Pending pod, and the deployment controller re-scales the RS back up
# mid-rollout (each deleted pod came back twice, three controllers deep).
# Deleting the stale RS removes the pods AND the respawner; the deployment
# controller never recreates old revisions. Pod deletion is also racy in the
# single-call sense the note below describes — an RS delete is
# atomic per RS and releases its ports the same way.
#
# ns refactor #31: kyverno runs in the `policies` namespace —
# this script targets it there. Cross-namespace deadlock variant hit live
# during the move: the OLD namespace's deployments held the ports while the
# new pods pended — deleting the old DEPLOYMENTS (not just their pods) is the
# same fix one level up.
#
# Exit 0 = nothing pending or unblock applied; nonzero = kubectl failure.

set -euo pipefail

usage() {
  echo "usage: kyverno_unblock" >&2
  exit 2
}

pending_pods() {
  kubectl -n policies get pods --no-headers \
    | awk '$3 == "Pending" {print $1}'
}

pod_deploy() { # pod name → deployment name (strip pod-hash, then rs-hash)
  local deploy="${1%-*}"
  echo "${deploy%-*}"
}

# all ReplicaSets of $1 EXCEPT its newest (the current pod template).
# sort_by creationTimestamp: last = the RS the deployment controller is
# rolling toward; everything older is stale.
stale_rs() {
  kubectl -n policies get rs -o json \
    | jq -r --arg d "$1" '
        [.items[]
         | select(.metadata.ownerReferences[]?.name == $d)
         | select(.metadata.labels."pod-template-hash" != null)
         | {name: .metadata.name, ts: .metadata.creationTimestamp}]
        | sort_by(.ts) | .[0:-1][]
        | .name // empty'
}

kyverno_unblock() {
  [ $# -eq 0 ] || usage
  local p pending deploy victims rs
  pending=$(pending_pods)
  if [ -z "$pending" ]; then
    echo "kyverno_unblock: no pending kyverno pods — nothing to do"
    return 0
  fi
  victims=""
  for p in $pending; do
    echo "pending: $p"
    deploy="$(pod_deploy "$p")"
    for rs in $(stale_rs "$deploy"); do
      case " $victims " in
        *" $rs "*) ;;          # already collected
        *) victims="$victims $rs" ;;
      esac
    done
  done
  if [ -z "$victims" ]; then
    echo "no stale ReplicaSets to delete — pending pods are newest-generation; describe them"
    return 0
  fi
  echo "deleting stale ReplicaSets (single call; pods die with them):"
  for v in $victims; do
    echo "  $v"
  done
  # shellcheck disable=SC2086
  kubectl -n policies delete rs $victims --wait=false
  echo "stale RSes deleted — ports freed, no respawner left; re-run flux_wait"
}

kyverno_unblock "$@"
