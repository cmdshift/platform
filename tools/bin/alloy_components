#!/usr/bin/env bash
# Dump the component list Grafana Alloy is actually running — the wedge-triage
# check for "is alloy running the config I think it is". The chart SILENTLY
# installs its example config when the HelmRelease's alloy.configMap wiring is
# missing (cmdshift/platform#27): pods stay healthy and push nothing, and the
# tell is discovery.kubernetes.{nodes,services,endpoints,...} components that
# aren't in config.alloy.
#   alloy_components [--all] [pod]   # default: first alloy pod; --all = whole DS
# Prints "component  health  message" per component. Exit 0 = all healthy,
# 1 = any unhealthy or the API/pod is unreachable, 2 = usage.

usage() {
  echo "usage: alloy_components [--all] [pod]" >&2
  exit 2
}

port_forward() { # namespace pod port container-port
  local i=0
  PORT_FORWARD_PORT=$(jot -r 1 22000 22999 2>/dev/null || echo 29125)
  kubectl -n "$1" port-forward "pod/$2" "$PORT_FORWARD_PORT:$3" >/dev/null 2>&1 &
  PORT_FORWARD_PID=$!
  trap 'kill $PORT_FORWARD_PID 2>/dev/null' EXIT
  until curl -s --max-time 2 "http://localhost:$PORT_FORWARD_PORT/api/v0/web/components" >/dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -gt 20 ] && { echo "port-forward to $2 never became ready" >&2; return 1; }
    sleep 0.5
  done
}

fetch_components() { # pod
  port_forward observability "$1" 12345 || return 1
  curl -s "http://localhost:$PORT_FORWARD_PORT/api/v0/web/components" \
    | jq -r 'if type != "array" or length == 0 then "NO COMPONENTS — example/config mismatch? see alloy_components header comment" else .[] | "\(.name).\(.label)\t\(.health.state)\t\(.health.message)" end'
  local rc=${PIPESTATUS[0]}
  kill $PORT_FORWARD_PID 2>/dev/null
  wait $PORT_FORWARD_PID 2>/dev/null
  return "$rc"
}

parse_args() { # -> ALL / POD globals
  [ $# -le 2 ] || usage
  all=0
  pod=""
  local arg
  for arg in "$@"; do
    case "$arg" in
      --all) all=1 ;;
      -*) usage ;;
      *) [ -z "$pod" ] || usage; pod="$arg" ;;
    esac
  done
}

pick_pods() { # -> PODS global; exit 1 when alloy is unreachable
  if [ "$all" -eq 1 ]; then
    [ -z "$pod" ] || usage # --all covers the whole DS; a pod arg contradicts it
    pods=$(kubectl -n observability get pods -l app.kubernetes.io/name=alloy -o name | cut -d/ -f2)
  else
    [ -n "$pod" ] || pod=$(kubectl -n observability get pods -l app.kubernetes.io/name=alloy -o name | head -1 | cut -d/ -f2)
    pods="$pod"
  fi
  [ -n "$pods" ] || { echo "no alloy pods found" >&2; return 1; }
}

alloy_components() {
  parse_args "$@"
  local p out rc=0
  pick_pods || return 1
  for p in $pods; do
    echo "== $p"
    out=$(fetch_components "$p") || rc=1
    printf '%s\n' "$out"
    if grep -qE $'\t(unhealthy|exited)\t' <<< "$out"; then rc=1; fi
  done
  return "$rc"
}

alloy_components "$@"
