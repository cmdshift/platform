#!/usr/bin/env bash
# Poll a velero backup/restore until it reaches Completed, echoing progress
# (polling discipline: the velero-ops skill). Reads the phase via kubectl on the
# fully-qualified CRD (backups.velero.io / restores.velero.io).
#   velero_wait backup|restore <name> [max_polls]   # 5s per poll; default 36 (~3m)
#   VELERO_NAMESPACE=<ns> overrides the install namespace (default: backups)
# Exit 0 = Completed. Exit 1 = Failed/PartiallyFailed/FailedValidation/Deleting
# (terminal — no point waiting) or timeout, each with a diagnose hint.
# Exit 2 = usage error.

set -euo pipefail

ns="${VELERO_NAMESPACE:-backups}"

usage() {
  echo "usage: velero_wait backup|restore <name> [max_polls]" >&2
  exit 2
}

help() { # print the header comment block
  awk 'NR==1 {next} /^#/ {sub(/^# ?/,""); print; next} {exit}' "$0"
}

diagnose_hint() {
  echo "diagnose: velero --kubeconfig \"\$KUBECONFIG\" -n $ns $1 describe $2 --details ; velero --kubeconfig \"\$KUBECONFIG\" -n $ns $1 logs $2 ; kubectl -n $ns get podvolumebackups,podvolumerestores"
}

velero_wait() {
  case "${1:-}" in -h|--help) help; exit 0 ;; esac
  local kind="${1:-}" name="${2:-}" max="${3:-36}"
  [ $# -ge 2 ] && [ $# -le 3 ] || usage
  case "$kind" in
    backup|restore) ;;
    *) usage ;;
  esac
  case "$max" in
    ''|*[!0-9]*|0) usage ;; # non-integer dies in the [ -ge ] test; 0 disables the poll guard
  esac

  local phase n=0
  while :; do
    # || true: a lookup failure (missing object, API down) must fall into
    # the timeout path below, not silently kill the script via set -e
    phase="$(kubectl -n "$ns" get "${kind}s.velero.io" "$name" -o jsonpath='{.status.phase}' 2>/dev/null || true)"
    case "$phase" in
      Completed)
        echo "velero_wait: $kind $name Completed"
        exit 0
        ;;
      Failed|PartiallyFailed|FailedValidation|Deleting)
        echo "velero_wait: $kind $name is $phase — stopped early"
        diagnose_hint "$kind" "$name"
        exit 1
        ;;
    esac
    n=$((n + 1))
    if [ "$n" -ge "$max" ]; then
      echo "velero_wait: TIMEOUT after $max polls (phase: ${phase:-not-found})"
      diagnose_hint "$kind" "$name"
      exit 1
    fi
    echo "[$n/$max] $kind $name: ${phase:-pending}"
    sleep 5
  done
}

velero_wait "$@"
