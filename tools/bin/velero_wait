#!/usr/bin/env bash
# Poll a velero backup/restore until it reaches Completed, echoing progress
# (see AGENTS.md polling discipline). The velero CLI has no jsonpath output
# (only table/json/yaml), hence the -o json | jq phase extraction.
#   velero_wait backup|restore <name> [max_polls]   # 5s per poll; default 36 (~3m)
# Exit 0 = Completed. Exit 1 = Failed/PartiallyFailed (terminal — no point
# waiting) or timeout, each with a diagnose hint.

set -euo pipefail

kind="${1:-}"
name="${2:-}"
max="${3:-36}"

usage() {
  echo "usage: velero_wait backup|restore <name> [max_polls]" >&2
  exit 2
}

[ -n "$name" ] || usage
case "$kind" in
  backup|restore) ;;
  *) usage ;;
esac

n=0
while :; do
  phase="$(velero -n velero get "$kind" "$name" -o json 2>/dev/null | jq -r '.status.phase // ""')"
  case "$phase" in
    Completed)
      echo "velero_wait: $kind $name Completed"
      exit 0
      ;;
    Failed|PartiallyFailed)
      echo "velero_wait: $kind $name is $phase — stopped early"
      echo "diagnose: velero -n velero $kind describe $name ; velero -n velero $kind logs $name"
      exit 1
      ;;
  esac
  n=$((n + 1))
  if [ "$n" -ge "$max" ]; then
    echo "velero_wait: TIMEOUT after $max polls (phase: ${phase:-not-found})"
    echo "diagnose: velero -n velero $kind describe $name ; kubectl -n velero get podvolumebackups,podvolumerestores"
    exit 1
  fi
  echo "[$n/$max] $kind $name: ${phase:-pending}"
  sleep 5
done
