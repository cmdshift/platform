#!/usr/bin/env bash
# Validate manifests against the ON-CLUSTER CRD schemas via server-side dry-run
# apply — nothing persists, but the full API + admission pipeline runs.
#   cr_validate [-n namespace] <file-or-dir>...
# Catches exactly what wedges a kustomization apply ("field not declared in
# schema", bad kinds, admission-webhook denials) WITHOUT the flux round-trip.
# Run it on any new/changed CR before sync_wait — the kustomize-controller
# dry-runs everything first, so one bad field blocks the whole group (observed
# twice with TracingPolicies, 2026-09-07).

cr_validate() {
  local fail=0 count=0 f out
  local files=() ns_args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--namespace)
        [ -n "${2:-}" ] || { echo "cr_validate: -n requires a value" >&2; return 2; }
        ns_args=(-n "$2"); shift 2 ;;
      -h|--help)
        sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; return 0 ;;
      -*)
        echo "cr_validate: unknown flag $1" >&2; return 2 ;;
      *)
        if [ -d "$1" ]; then
          while IFS= read -r -d '' f; do files+=("$f"); done < <(find "$1" -name '*.yaml' -print0)
        else
          files+=("$1")
        fi
        shift ;;
    esac
  done
  [ "${#files[@]}" -gt 0 ] || { echo "usage: cr_validate [-n namespace] <file-or-dir>..." >&2; return 2; }

  for f in "${files[@]}"; do
    count=$((count+1))
    if out=$(kubectl apply --dry-run=server --validate=strict "${ns_args[@]}" -f "$f" 2>&1); then
      echo "PASS: $f"
    else
      echo "FAIL: $f"
      sed 's/^/  /' <<< "$out"
      fail=1
    fi
  done
  if [ "$fail" -eq 0 ]; then
    echo "OK: $count manifest(s) validate against the cluster"
  fi
  return "$fail"
}

cr_validate "$@"
