#!/usr/bin/env bash
# Post-scrape-change verification summary — the check repeated after every
# collector scrape edit: per-family up-target counts from O2 (grouped by
# service_name — the OTel receiver translates job → service_name) and the
# series total.
# Sits on prometheus_query's shared forward — no own plumbing.
#   metrics_summary                    one line per family: "<n> family" sorted by name
#   metrics_summary -t                 + TOTAL line
#   metrics_summary --raw '<promql>'   escape hatch: any instant query, compact form
# Exit 0 = query ran (empty output = no series — investigate), 1 = forward
# failed, 2 = usage error, 3 = O2 rejected the query (prometheus_query -c).
set -euo pipefail

usage() {
  echo "usage: metrics_summary [-t] | metrics_summary --raw '<promql>'" >&2
  exit 2
}

help() { # print the header comment block
  awk 'NR==1 {next} /^#/ {sub(/^# ?/,""); print; next} {exit}' "$0"
}

case "${1:-}" in -h|--help) help; exit 0 ;; esac
totals=0 raw=''
while [ $# -gt 0 ]; do
  case "$1" in
    -t) totals=1; shift ;;
    --raw) [ -n "${2:-}" ] || usage; raw="$2"; shift 2 ;;
    -*) usage ;;
    *) usage ;;
  esac
done

tool_dir="$(cd "$(dirname "$0")" && pwd)"

if [ -n "$raw" ]; then
  exec "$tool_dir/prometheus_query" -c "$raw"
fi

"$tool_dir/prometheus_query" -c 'count by (service_name) (up)' \
  | sed -E 's/^service_name=([^:]+): ([0-9]+)$/\2 \1/' \
  | sort -k2

if [ "$totals" -eq 1 ]; then
  "$tool_dir/prometheus_query" -c 'count(up)' | sed -E 's/^: ([0-9]+)$/TOTAL \1/'
fi
