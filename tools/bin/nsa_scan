#!/usr/bin/env bash
# Kubescape NSA posture scan, two views:
#   nsa_scan              full cluster scan + accepted findings (default)
#   nsa_scan full         same, explicit
#   nsa_scan apps         app-namespaces-only view (kube-system excluded)
#
# Every acceptance ships as a SecurityException / ClusterSecurityException
# resource (kubescape.io/v1beta1) in
# manifests/local/security-config/*.security-exception.yaml, applied by flux —
# kubescape reads them automatically at scan time. Each maps to a kyverno
# PolicyException or a rationale in manifests/local/notes.md; keep them in
# sync: an exception without a documented reason doesn't belong there.
#
# --exceptions with an empty file replaces the ARMO-portal exception download
# (the source of bundled GKE/AKS/EKS "systemException" defaults). Those
# defaults overlap our in-cluster CRs and, being file-level, take precedence
# over them (documented kubescape precedence) — leaving the overlapped
# findings as failed-with-exceptions (acknowledgedResources). An empty list
# makes the in-cluster CRs the only exception source, so the GitOps objects
# govern the score. (--exceptions DOES work on 4.0.13 — the earlier
# "silently no-ops" note here was wrong; the observed no-op was the portal
# set outranking in-cluster CRs, not a dead flag.)
#
# Why the apps view can score LOWER than the full scan: kubescape's score is
# severity-weighted over scanned resources — excluding kube-system strips
# hundreds of passing resources, so the remaining failures weigh heavier.
# The full scan is the headline number; the apps view answers "what would a
# prod-style app-namespace scan say".

set -euo pipefail

OUT="${TMPDIR:-/tmp}/opencode"
# empty exceptions file: disables the ARMO portal exception download (see header)
EXCEPTIONS_FILE="$OUT/empty-exceptions.json"
mkdir -p "$OUT"
[[ -s "$EXCEPTIONS_FILE" ]] || echo '[]' > "$EXCEPTIONS_FILE"

score_and_fails() {
  local file="$1" label="$2"
  jq -r --arg l "$label" '"\($l) score: \(.summaryDetails.complianceScore)"' "$file" 2>/dev/null \
    || echo "$label score: see $file"
  echo "remaining failing controls ($label):"
  jq -r '
    .results[] | .resourceID as $rid |
    .controls[] | select(.status.status == "failed") |
    [.controlID, ($rid | split("//")[0] | sub("apps/v1/"; ""))] | @tsv' "$file" 2>/dev/null |
    sort | uniq -c | sort -rn | head -15
}

scan_full() {
  echo "=== full cluster scan (in-cluster SecurityExceptions applied) ==="
  kubescape scan framework nsa --format json --output "$OUT/nsa-full.json" \
    --exceptions "$EXCEPTIONS_FILE" >/dev/null 2>&1
  score_and_fails "$OUT/nsa-full.json" "full"
}

scan_apps() {
  echo "=== apps-only scan (kube-system excluded) ==="
  kubescape scan framework nsa --format json --output "$OUT/nsa-apps.json" \
    --exclude-namespaces kube-system --exceptions "$EXCEPTIONS_FILE" >/dev/null 2>&1
  score_and_fails "$OUT/nsa-apps.json" "apps"
}

case "${1:-full}" in
  full) scan_full ;;
  apps) scan_apps ;;
  both) scan_full; echo; scan_apps ;;
  *) echo "usage: nsa_scan [full|apps|both]" >&2; exit 1 ;;
esac
