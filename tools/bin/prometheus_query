#!/usr/bin/env bash
# PromQL query against OpenObserve's Prometheus-compat API, with the
# port-forward lifecycle handled: a per-service forward is started once and
# SHARED across invocations via a lock file
# (${TMPDIR:-/tmp}/prometheus_query.<service>.forward, "<pid> <port>") —
# rapid loops stop churning listeners, and a wedged/dead forward is evicted
# and replaced on the next call. A not-ready server is waited out (bounded
# 2m): the ready check distinguishes "forward up, server not ready" (HTTP
# non-200) from "forward dead" (refused/timeout). `--stop` evicts the shared
# forwards. The lifecycle is duplicated in log_query (same
# svc/openobserve:5080, same auth cache discipline — keep the two in
# lockstep): this tool speaks PromQL to O2's Prometheus-compat API,
# log_query speaks O2 SQL to the _search API (cmdshift/platform#171 removed
# mimir/loki with the LGTM stack; the log rewiring is cmdshift/platform#203).
# Queries svc/openobserve ns observability, port 5080; the org is hardcoded
# `default` (the collectors push to /api/default/, no X-Scope-OrgID — that
# was mimir multi-tenancy). Auth is the collectors' inlined Basic token,
# read live from cm/openobserve-collector-agent-values and cached at
# .agents/temp/prometheus_query.o2.auth — never embedded here (it must be
# re-encoded whenever the secrets-server `openobserve-credentials` payload
# changes; a 401 invalidates the cache and refetches once).
#   prometheus_query '<promql>'              instant, raw JSON
#   prometheus_query -v '<promql>'            values only (value + labels, or ts value)
#   prometheus_query -c '<promql>'            compact: "<pod=... container=...> vals" per line
#   prometheus_query -r 6h '<promql>'         range over the last 6h (m|h|d), auto step
#   prometheus_query --stop                   evict the shared forwards
# Exit 0 = query ran (check the JSON/values for emptiness), 1 = forward
# failed to establish, the server stayed not-ready for 2m, or auth failed
# after a token refetch, 2 = usage error.

usage() {
  echo "usage: prometheus_query [-v|-c] [-r 6h] '<promql>' | prometheus_query --stop" >&2
  exit 2
}

range_start() { # e.g. 6h -> epoch seconds; bash math off `date +%s` (portable —
  # BSD `date -v` is darwin-only, GNU `date -d` is linux-only, +%s is both)
  case "$1" in
    [0-9]*m) n=${1%m}; u=60 ;;
    [0-9]*h) n=${1%h}; u=3600 ;;
    [0-9]*d) n=${1%d}; u=86400 ;;
    *)  return 1 ;;
  esac
  case "$n" in *[!0-9]*|'') return 1 ;; esac # a float here aborts the script in $(( )) before `|| usage` can fire
  echo $(( $(date +%s) - n * u ))
}

# --- shared port-forward lifecycle (duplicated in log_query — keep in lockstep) ---

# { } around the fallback — bash parses `a || b && c` as `(a || b) && c`, so
# with the plain form `cd && pwd` ran even on the git success path and its
# output got appended to REPO_ROOT (two lines), producing a garbage LOCK_DIR
REPO_ROOT="$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel 2>/dev/null || { cd "$(dirname "$0")/../.." && pwd; })"
LOCK_DIR="$REPO_ROOT/.agents/temp"
mkdir -p "$LOCK_DIR"
AUTH_CACHE="$LOCK_DIR/prometheus_query.o2.auth"

http_answer() { # url — exit 0 once any HTTP response arrives; curl exit 0 covers
  # 200 AND 503, while refused/timeout exit non-zero — that distinction is
  # what separates "still binding" from "server not ready"
  curl -s --max-time 2 -o /dev/null "$1"
}

http_200() { # url
  [ "$(curl -s --max-time 2 -o /dev/null -w '%{http_code}' "$1")" = 200 ]
}

is_port_forward() { # pid — the recorded PID must still name a port-forward before
  # we reuse or kill it (PID recycling would otherwise reuse/kill a stranger)
  ps -p "$1" -o command= 2>/dev/null | grep -q port-forward
}

stop_forwards() { # evict every forward this tool has recorded
  local lock pid port
  for lock in "$LOCK_DIR"/prometheus_query.*.forward; do
    [ -f "$lock" ] || continue
    read -r pid port < "$lock" 2>/dev/null || true
    if [ "${pid:-}" ] && is_port_forward "$pid"; then
      kill "$pid" 2>/dev/null && echo "stopped forward pid=$pid port=$port"
    fi
    rm -f "$lock"
  done
}

o2_token() { # the O2 Basic token, read from the cluster at runtime — never
  # hardcoded (it changes with the secrets-server openobserve-credentials
  # payload; observability README 401 landmine). Cached at AUTH_CACHE so
  # rapid loops don't re-run kubectl per query; a 401 below rm's the cache.
  if [ -s "$AUTH_CACHE" ]; then
    cat "$AUTH_CACHE"
    return
  fi
  local token
  token=$(kubectl -n observability get cm openobserve-collector-agent-values \
    -o jsonpath='{.data.values\.yaml}' 2>/dev/null \
    | grep -m1 'Authorization: "Basic ' | sed 's/.*"Basic /Basic /;s/".*//')
  [ -n "$token" ] || { echo "cannot read the O2 auth token from cm/openobserve-collector-agent-values (ns observability)" >&2; return 1; }
  printf '%s\n' "$token" > "$AUTH_CACHE"
  echo "$token"
}

port_forward() { # service_name — sets PORT_FORWARD_PORT / PORT_FORWARD_PID
  local service=$1 lock i pid port
  lock="$LOCK_DIR/prometheus_query.$service.forward"
  unset PORT_FORWARD_PID PORT_FORWARD_PORT
  if [ -f "$lock" ]; then
    read -r pid port < "$lock" 2>/dev/null
    if [ "${pid:-}" ] && [ "${port:-}" ] && kill -0 "$pid" 2>/dev/null \
       && is_port_forward "$pid"; then
      PORT_FORWARD_PID=$pid
      PORT_FORWARD_PORT=$port
    else # stale lock: evict a genuine forward, forget a recycled PID
      if [ "${pid:-}" ] && is_port_forward "$pid"; then kill "$pid" 2>/dev/null; fi
      rm -f "$lock"
    fi
  fi
  if [ -z "${PORT_FORWARD_PORT:-}" ]; then
    # fresh forward; one restart when kubectl dies (transient bind collision —
    # random-port collisions are rare but cheaper to retry than to fail)
    # O2's API lives on 5080; /healthz is the unauthenticated ready check
    # (/ready and the query API require auth — cmdshift/platform#186)
    for _ in 1 2; do
      PORT_FORWARD_PORT=$((20000 + RANDOM % 1000))
      kubectl -n observability port-forward "svc/$service" "$PORT_FORWARD_PORT:5080" >/dev/null 2>&1 &
      PORT_FORWARD_PID=$!
      # the ready check runs before port_forward returns; READY_PATH must be
      # set here, not just at the query-URL build site below
      READY_PATH=/healthz
      i=0
      until http_answer "http://localhost:$PORT_FORWARD_PORT$READY_PATH"; do
        i=$((i + 1))
        kill -0 "$PORT_FORWARD_PID" 2>/dev/null || break
        [ "$i" -gt 20 ] && { echo "port-forward failed to establish" >&2; return 1; }
        sleep 0.5
      done
      kill -0 "$PORT_FORWARD_PID" 2>/dev/null && break
    done
    kill -0 "$PORT_FORWARD_PID" 2>/dev/null || { echo "port-forward failed to establish" >&2; return 1; }
  else
    # reused forward: bounded liveness probe before trusting it — a wedged
    # kubectl keeps its PID while the port stops answering
    READY_PATH=/healthz
    i=0
    until http_answer "http://localhost:$PORT_FORWARD_PORT$READY_PATH"; do
      i=$((i + 1))
      [ "$i" -gt 12 ] && {
        kill "$PORT_FORWARD_PID" 2>/dev/null
        rm -f "$lock"
        port_forward "$service" # evict → fresh start (recursion depth 1: the lock is gone)
        return
      }
      sleep 0.5
    done
  fi
  # ready budget: HTTP non-200 here is the server not ready — wait it out;
  # only a dead forward fails immediately. On expiry the forward is recorded
  # anyway, so the next call rides the same one. O2 /healthz returns 200
  # once the HTTP server is up (no WAL-replay-style wait observed live).
  i=0
  while ! http_200 "http://localhost:$PORT_FORWARD_PORT$READY_PATH"; do
    kill -0 "$PORT_FORWARD_PID" 2>/dev/null || { echo "port-forward failed to establish" >&2; return 1; }
    i=$((i + 1))
    [ "$i" -gt 240 ] && {
      echo "openobserve not ready after 2m; retry shortly" >&2
      printf '%s %s\n' "$PORT_FORWARD_PID" "$PORT_FORWARD_PORT" > "$lock"
      return 1
    }
    sleep 0.5
  done
  printf '%s %s\n' "$PORT_FORWARD_PID" "$PORT_FORWARD_PORT" > "$lock"
}

format_values() {
  jq -r '
    if .data.result then
      .data.result[]?
      | (if .values then .values[] | "\(.[0]) \(.[1])"
         else "\(.value[1]) \(.metric | del(.__name__) | to_entries | map("\(.key)=\(.value)") | join(","))"
         end)
    else . end'
}

format_compact() { # one line per series: short label subset + values (token-cheap; -v strips
  # labels entirely, raw JSON drowns them in id/image/instance noise)
  jq -r '
    def kept: ["pod","container","job","namespace","instance","service","endpoint","device","persistentvolumeclaim","policy","policy_group","rule"];
    def labels_c:
      .metric as $m
      | ([kept[] | select($m[.] != null) | "\(.)=\($m[.])"]) as $picked
      | if ($picked | length) > 0 then $picked | join(" ")
        else $m | del(.__name__) | to_entries | map("\(.key)=\(.value)") | join(",") end;
    .data.result[]?
    | (if .values then .values | map(.[1]) | join(" ") else .value[1] end) as $vals
    | labels_c as $l
    | "\($l): \($vals)"'
}

prometheus_query() {
  local service=openobserve mode=instant values=0 compact=0 range='' query=''
  local start='' end='' step=''
  while [ $# -gt 0 ]; do
    case "$1" in
      -v) values=1; shift ;;
      -c) compact=1; shift ;;
      -r) [ -n "${2:-}" ] || usage # '-r' alone: the failed shift leaves $1='-r' forever
          range="$2"; mode=range; shift 2 ;;
      -*) usage ;; # an unknown flag would silently be swallowed as/next to the query
      *) [ -z "$query" ] || usage # one query only — last-one-wins hides the mistake
         query="$1"; shift ;;
    esac
  done
  [ -n "$query" ] || usage
  { [ "$values" -eq 0 ] || [ "$compact" -eq 0 ]; } || usage # -v and -c are mutually exclusive
  if [ "$mode" = range ]; then
    start=$(range_start "$range") || usage # validate before port-forward, not after
  fi

  port_forward "$service" || return 1
  # O2 serves the prometheus-compat query API under /api/{org}/prometheus —
  # the org is hardcoded default (cmdshift/platform#186)
  local base="http://localhost:$PORT_FORWARD_PORT/api/default/prometheus/api/v1"
  local url="$base/query"

  if [ "$mode" = range ]; then
    end=$(date +%s)
    step=$(( (end - start) / 30 )); [ "$step" -lt 60 ] && step=60
    url="$base/query_range?start=$start&end=$end&step=$step"
  fi

  local token out code
  token=$(o2_token) || return 1
  out=$(curl -sG -w '\n%{http_code}' --max-time 15 "$url" --data-urlencode "query=$query" -H "Authorization: $token")
  code=${out##*$'\n'}
  if [ "$code" = 401 ]; then
    # cached token went stale (secrets-server payload changed) — refetch once
    rm -f "$AUTH_CACHE"
    token=$(o2_token) || return 1
    out=$(curl -sG -w '\n%{http_code}' --max-time 15 "$url" --data-urlencode "query=$query" -H "Authorization: $token")
    code=${out##*$'\n'}
    [ "$code" = 401 ] && { echo "O2 rejected the token even after a refetch — re-encode the collector values (observability README 401 landmine)" >&2; return 1; }
  fi
  out=${out%$'\n'*}

  if [ "$compact" = 1 ]; then
    printf '%s\n' "$out" | format_compact
  elif [ "$values" = 1 ]; then
    printf '%s\n' "$out" | format_values
  else
    printf '%s\n' "$out"
    echo
  fi
}

if [ "${1:-}" = "--stop" ]; then
  [ $# -eq 1 ] || usage
  stop_forwards
  exit 0
fi

prometheus_query "$@"
