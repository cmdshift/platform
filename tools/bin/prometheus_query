#!/usr/bin/env bash
# Prometheus query with the port-forward lifecycle handled: a per-service
# forward is started once and SHARED across invocations via a lock file
# (${TMPDIR:-/tmp}/prometheus_query.<service>.forward, "<pid> <port>") —
# rapid loops stop churning listeners, and a wedged/dead forward is evicted
# and replaced on the next call. A not-ready prometheus (WAL replay) is
# waited out (bounded 2m): the ready check distinguishes "forward up, server
# not ready" (HTTP non-200) from "forward dead" (refused/timeout). `--stop`
# evicts the shared forwards. The lifecycle is duplicated in loki_query —
# keep the two in lockstep.
#   prometheus_query '<promql>'              instant, raw JSON
#   prometheus_query -v '<promql>'            values only (value + labels, or ts value)
#   prometheus_query -c '<promql>'            compact: "<pod=... container=...> vals" per line
#   prometheus_query -r 6h '<promql>'         range over the last 6h (m|h|d), auto step
#   prometheus_query --query '<promql>'       against svc/mimir instead
#   prometheus_query --stop                   evict the shared forwards
# Exit 0 = query ran (check the JSON/values for emptiness), 1 = forward
# failed to establish or the server stayed not-ready for 2m, 2 = usage error.

usage() {
  echo "usage: prometheus_query [-v|-c] [-r 6h] [--query] '<promql>' | prometheus_query --stop" >&2
  exit 2
}

range_start() { # e.g. 6h -> epoch seconds; bash math off `date +%s` (portable —
  # BSD `date -v` is darwin-only, GNU `date -d` is linux-only, +%s is both)
  case "$1" in
    [0-9]*m) n=${1%m}; u=60 ;;
    [0-9]*h) n=${1%h}; u=3600 ;;
    [0-9]*d) n=${1%d}; u=86400 ;;
    *)  return 1 ;;
  esac
  case "$n" in *[!0-9]*|'') return 1 ;; esac # a float here aborts the script in $(( )) before `|| usage` can fire
  echo $(( $(date +%s) - n * u ))
}

# --- shared port-forward lifecycle (duplicated in loki_query — keep in lockstep) ---

# { } around the fallback — bash parses `a || b && c` as `(a || b) && c`, so
# with the plain form `cd && pwd` ran even on the git success path and its
# output got appended to REPO_ROOT (two lines), producing a garbage LOCK_DIR
REPO_ROOT="$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel 2>/dev/null || { cd "$(dirname "$0")/../.." && pwd; })"
LOCK_DIR="$REPO_ROOT/.agents/temp"
mkdir -p "$LOCK_DIR"

http_answer() { # url — exit 0 once any HTTP response arrives; curl exit 0 covers
  # 200 AND 503, while refused/timeout exit non-zero — that distinction is
  # what separates "still binding" from "server not ready"
  curl -s --max-time 2 -o /dev/null "$1"
}

http_200() { # url
  [ "$(curl -s --max-time 2 -o /dev/null -w '%{http_code}' "$1")" = 200 ]
}

is_port_forward() { # pid — the recorded PID must still name a port-forward before
  # we reuse or kill it (PID recycling would otherwise reuse/kill a stranger)
  ps -p "$1" -o command= 2>/dev/null | grep -q port-forward
}

stop_forwards() { # evict every forward this tool has recorded
  local lock pid port
  for lock in "$LOCK_DIR"/prometheus_query.*.forward; do
    [ -f "$lock" ] || continue
    read -r pid port < "$lock" 2>/dev/null || true
    if [ "${pid:-}" ] && is_port_forward "$pid"; then
      kill "$pid" 2>/dev/null && echo "stopped forward pid=$pid port=$port"
    fi
    rm -f "$lock"
  done
}

port_forward() { # service_name — sets PORT_FORWARD_PORT / PORT_FORWARD_PID
  local service=$1 lock i pid port attempt
  lock="$LOCK_DIR/prometheus_query.$service.forward"
  unset PORT_FORWARD_PID PORT_FORWARD_PORT
  if [ -f "$lock" ]; then
    read -r pid port < "$lock" 2>/dev/null
    if [ "${pid:-}" ] && [ "${port:-}" ] && kill -0 "$pid" 2>/dev/null \
       && is_port_forward "$pid"; then
      PORT_FORWARD_PID=$pid
      PORT_FORWARD_PORT=$port
    else # stale lock: evict a genuine forward, forget a recycled PID
      if [ "${pid:-}" ] && is_port_forward "$pid"; then kill "$pid" 2>/dev/null; fi
      rm -f "$lock"
    fi
  fi
  if [ -z "${PORT_FORWARD_PORT:-}" ]; then
    # fresh forward; one restart when kubectl dies (transient bind collision —
    # random-port collisions are rare but cheaper to retry than to fail)
    # mimir's query API lives on 8080 under /prometheus, not 9090 —
    # remap the port and switch the ready path (cmdshift/platform#128)
    if [ "$service" = mimir ]; then
      PORT_MAP="8080"
    else
      PORT_MAP="9090"
    fi
    for attempt in 1 2; do
      PORT_FORWARD_PORT=$((20000 + RANDOM % 1000))
      kubectl -n observability port-forward "svc/$service" "$PORT_FORWARD_PORT:$PORT_MAP" >/dev/null 2>&1 &
      PORT_FORWARD_PID=$!
      # the ready check runs before port_forward returns; READY_PATH must be
      # set here, not just at the query-URL build site below
      if [ "$service" = mimir ]; then
        READY_PATH=/ready
      else
        READY_PATH=/-/ready
      fi
      i=0
      until http_answer "http://localhost:$PORT_FORWARD_PORT$READY_PATH"; do
        i=$((i + 1))
        kill -0 "$PORT_FORWARD_PID" 2>/dev/null || break
        [ "$i" -gt 20 ] && { echo "port-forward failed to establish" >&2; return 1; }
        sleep 0.5
      done
      kill -0 "$PORT_FORWARD_PID" 2>/dev/null && break
    done
    kill -0 "$PORT_FORWARD_PID" 2>/dev/null || { echo "port-forward failed to establish" >&2; return 1; }
  else
    # reused forward: bounded liveness probe before trusting it — a wedged
    # kubectl keeps its PID while the port stops answering
    if [ "$service" = mimir ]; then READY_PATH=/ready; else READY_PATH=/-/ready; fi
    i=0
    until http_answer "http://localhost:$PORT_FORWARD_PORT$READY_PATH"; do
      i=$((i + 1))
      [ "$i" -gt 12 ] && {
        kill "$PORT_FORWARD_PID" 2>/dev/null
        rm -f "$lock"
        port_forward "$service" # evict → fresh start (recursion depth 1: the lock is gone)
        return
      }
      sleep 0.5
    done
  fi
  # ready budget: HTTP 503 here is the server not ready (WAL replay) — wait it
  # out; only a dead forward fails immediately. On expiry the forward is
  # recorded anyway, so the next call rides the same one. Mimir's /ready
  # returns 200 with a body ("ready") rather than a bare 200 — http_200 works.
  i=0
  while ! http_200 "http://localhost:$PORT_FORWARD_PORT$READY_PATH"; do
    kill -0 "$PORT_FORWARD_PID" 2>/dev/null || { echo "port-forward failed to establish" >&2; return 1; }
    i=$((i + 1))
    [ "$i" -gt 240 ] && {
      echo "prometheus not ready after 2m — likely WAL replay; retry shortly" >&2
      printf '%s %s\n' "$PORT_FORWARD_PID" "$PORT_FORWARD_PORT" > "$lock"
      return 1
    }
    sleep 0.5
  done
  printf '%s %s\n' "$PORT_FORWARD_PID" "$PORT_FORWARD_PORT" > "$lock"
}

format_values() {
  jq -r '
    if .data.result then
      .data.result[]?
      | (if .values then .values[] | "\(.[0]) \(.[1])"
         else "\(.value[1]) \(.metric | del(.__name__) | to_entries | map("\(.key)=\(.value)") | join(","))"
         end)
    else . end'
}

format_compact() { # one line per series: short label subset + values (token-cheap; -v strips
  # labels entirely, raw JSON drowns them in id/image/instance noise)
  jq -r '
    def kept: ["pod","container","job","namespace","instance","service","endpoint","device","persistentvolumeclaim","policy","policy_group","rule"];
    def labels_c:
      .metric as $m
      | ([kept[] | select($m[.] != null) | "\(.)=\($m[.])"]) as $picked
      | if ($picked | length) > 0 then $picked | join(" ")
        else $m | del(.__name__) | to_entries | map("\(.key)=\(.value)") | join(",") end;
    .data.result[]?
    | (if .values then .values | map(.[1]) | join(" ") else .value[1] end) as $vals
    | labels_c as $l
    | "\($l): \($vals)"'
}

prometheus_query() {
  local service=kube-prometheus-stack-prometheus mode=instant values=0 compact=0 range='' query=''
  local start='' end='' step=''
  while [ $# -gt 0 ]; do
    case "$1" in
      -v) values=1; shift ;;
      -c) compact=1; shift ;;
      -r) [ -n "${2:-}" ] || usage # '-r' alone: the failed shift leaves $1='-r' forever
          range="$2"; mode=range; shift 2 ;;
      --query) service=mimir; shift ;;
      -*) usage ;; # an unknown flag would silently be swallowed as/next to the query
      *) [ -z "$query" ] || usage # one query only — last-one-wins hides the mistake
         query="$1"; shift ;;
    esac
  done
  [ -n "$query" ] || usage
  { [ "$values" -eq 0 ] || [ "$compact" -eq 0 ]; } || usage # -v and -c are mutually exclusive
  if [ "$mode" = range ]; then
    start=$(range_start "$range") || usage # validate before port-forward, not after
  fi

  port_forward "$service" || return 1
  # mimir serves the prometheus query API under the /prometheus prefix
  # (cmdshift/platform#128); READY_PATH for the liveness probe is set inside
  # port_forward since the ready check runs before it returns
  if [ "$service" = mimir ]; then
    API_PREFIX=/prometheus
  else
    API_PREFIX=''
  fi
  local url="http://localhost:$PORT_FORWARD_PORT${API_PREFIX}/api/v1/query"

  if [ "$mode" = range ]; then
    end=$(date +%s)
    step=$(( (end - start) / 30 )); [ "$step" -lt 60 ] && step=60
    url="http://localhost:$PORT_FORWARD_PORT${API_PREFIX}/api/v1/query_range?start=$start&end=$end&step=$step"
  fi

  if [ "$compact" = 1 ]; then
    curl -sG "$url" --data-urlencode "query=$query" -H 'X-Scope-OrgID: self-monitoring' | format_compact
  elif [ "$values" = 1 ]; then
    curl -sG "$url" --data-urlencode "query=$query" -H 'X-Scope-OrgID: self-monitoring' | format_values
  else
    curl -sG "$url" --data-urlencode "query=$query" -H 'X-Scope-OrgID: self-monitoring'
    echo
  fi
}

if [ "${1:-}" = "--stop" ]; then
  [ $# -eq 1 ] || usage
  stop_forwards
  exit 0
fi

prometheus_query "$@"